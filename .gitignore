# PCSX5 Emulator Gitignore

# CMake build outputs
/build/
/out/
/CMakeSettings.json
/CMakeUserPresets.json

# MSVC / Visual Studio files
.vs/
*.user
*.suo
*.db
*.opendb
*.ipch
*.sdf
*.VC.db
*.VC.opendb
.trae/

# Compiled Binaries & Libraries
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp
*.obj
*.o
*.a
*.so

# Game dumps, backups, and user logs
/Games/
*.log
/crash_log.txt
/user/
/logs/
/saves/

# Per-title boot-run evidence logs and runtime save-data dir
/ppsa*_run*.log
/ppsa*_wave*.log
/ppsa*_run*_stdout.txt
/pcsx5_savedata/
.log

# OS-specific files
.DS_Store
Thumbs.db

# IDE Configs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
pcsx5_config/
pcsx5_crash/
covers/
testing/

imgui.ini
baddream_decoded.wav
snd0_decoded.wav
TASKLIST.md
ps5.csv
# Python cache
__pycache__/
*.pyc
.gitignore
.gitignore
generate_compat_table.py
deploy_compatibility_repo.py
deploy_compatibility_repo.bat
create_github_issues.py

# affinity file for pcsx5.exe
PCSX5.af 

dist/
issues.txt

# .NET build artifacts (accidentally committed earlier)
src/ui_csharp/obj/
src/ui_csharp/bin/

# Reference-only clone of sharpemu, not part of the repo
sharpemu_clone/

# Local build/test helper scripts
build_phase1.bat
test_phase1.bat

# Scratch / work-in-progress notes
.work/

# Inno Setup compiler output
installer/Output/

# Milestone run logs and capture artifacts
/ppsa*_m*.log
/vk_smoke_run.log
/vk_smoke_frame.png
/m1b_window.png
/shader_corpus_report.txt

# Runtime shader disk cache (regenerated at runtime)
/Cache/
/kyty_clone/
/Testing/
/scratch/

# Temporary debug logs, traces, and crash minidumps
boot_log*.txt
boot_log*.log
run_log*.txt
diag_trap*.txt
diag_output.txt
ppsa*_run*.txt
ppsa*_diag*.txt
ppsa*_loader*.txt
ppsa*_kernel*.txt
*.dmp
*.dump
*.trace
*.tmp

# Always preserve curated evidence in docs/evidence/
!docs/evidence/**
/artifacts/
releases/

# ---------------------------------------------------------------------------
# Local AI engineering tooling — development aids, not part of the emulator.
# Kept on disk, deliberately not published.
# ---------------------------------------------------------------------------
.claude/
.gemini/
CLAUDE.md
GEMINI.md

# Offline-only analysis output and scratch artifacts
/crash_prx_dump.bin
/crash_rip_dump.bin
/prev.bin
/imports.txt
/imports_summary.txt
/count_tokens.py
/patch_logging.py
/temp/
/memory/
/tools/validate_ai_framework.py
