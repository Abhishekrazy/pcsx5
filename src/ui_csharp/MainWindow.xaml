                                    <DropShadowEffect Color="#0099FF" BlurRadius="40" Opacity="0.4" ShadowDepth="0"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Header -->
                                    <TextBlock Text="P A U S E D" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#6FA0A0A5"
 HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                    <TextBlock x:Name="PauseMenuGameTitle" Text="" FontSize="{DynamicResource Type3XL}" FontWeight="ExtraBold"
 Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,24"
 TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>

                                    <!-- Menu Items -->
                                    <Button x:Name="PauseResumeBtn" Focusable="True" MinHeight="52" Margin="24,0,24,8"
 Click="PauseResume_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#200099FF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#400099FF"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="16,0">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter Property="Background" Value="#3F0099FF"/>
                                                        <Setter Property="BorderBrush" Value="#0099FF"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#2A0099FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶" FontSize="{DynamicResource TypeL}" Foreground="#0099FF" VerticalAlignment="Center" Margin="0,0,12,0"/>
