                            <RowDefinition x:Name="GameContentBottomRow" Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Emulator window is reparented into this area (HwndHost) -->
                        <Border x:Name="EmulatorHostBorder" Grid.Row="0" Grid.Column="0" Background="{DynamicResource ThemeGround}">
                            <ContentControl x:Name="EmulatorHostPresenter"/>
                        </Border>

                        <!-- Console panel — changes position based on dock mode -->
                        <Border x:Name="GameConsolePanel" Grid.Row="0" Grid.Column="1" Width="380" Visibility="Collapsed" Panel.ZIndex="10"
 Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Header with dock buttons -->
                                <Grid Grid.Row="0" Margin="10,10,10,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Key=ui.console}" FontSize="{DynamicResource TypeML}" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="ConsoleDockBottomBtn" MinWidth="68" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="4,0" ToolTip="{loc:Tr Key=ui.dock_bottom}"
 Click="ConsoleDockMode_Click" Tag="Bottom" Style="{StaticResource ModernButtonStyle}">⬇ Bottom</Button>
                                        <Button x:Name="ConsoleDockRightBtn" MinWidth="65" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="4,0" Margin="4,0,0,0" ToolTip="{loc:Tr Key=ui.dock_right}"
 Click="ConsoleDockMode_Click" Tag="Right" Style="{StaticResource ModernButtonStyle}">➡ Right</Button>
                                        <Button x:Name="ConsoleDockLeftBtn" MinWidth="60" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="4,0" Margin="4,0,0,0" ToolTip="{loc:Tr Key=ui.dock_left}"
 Click="ConsoleDockMode_Click" Tag="Left" Style="{StaticResource ModernButtonStyle}">⬅ Left</Button>
                                        <Button x:Name="ConsoleDockFloatBtn" MinWidth="62" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="4,0" Margin="4,0,0,0" ToolTip="{loc:Tr Key=ui.undock}"
 Click="ConsoleDockMode_Click" Tag="Float" Style="{StaticResource ModernButtonStyle}">↗ Float</Button>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="GameConsoleSlot" Grid.Row="1" Margin="8,0,8,6">
                                    <Border x:Name="ConsoleBorder" Background="{DynamicResource ThemeGround}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerM}" Padding="12">
                                        <RichTextBox x:Name="ConsoleOutputBox" Background="Transparent" FontFamily="Consolas, Courier New" FontSize="{DynamicResource TypeM}"
 BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
 HorizontalScrollBarVisibility="Disabled" IsDocumentEnabled="True">
                                            <RichTextBox.Resources>
                                                <Style TargetType="Paragraph"><Setter Property="Margin" Value="0,0,0,1"/></Style>
                                            </RichTextBox.Resources>
                                        </RichTextBox>
                                    </Border>
                                </Border>
                                <!-- Console action buttons -->
                                <Grid Grid.Row="2" Margin="10,4,10,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <CheckBox x:Name="AutoScrollCheck" Content="{loc:Tr Key=ui.scroll}" IsChecked="True" Foreground="{DynamicResource ThemeTextMuted}" FontSize="{DynamicResource TypeS}"
 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="{loc:Tr Key=ui.copy}" MinWidth="60" MinHeight="28" FontSize="{DynamicResource TypeS}" Padding="6,0" Style="{StaticResource ModernButtonStyle}" Click="CopyConsole_Click"/>
                                        <Button Content="{loc:Tr Key=ui.clear}" MinWidth="60" MinHeight="28" FontSize="{DynamicResource TypeS}" Padding="6,0" Margin="6,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="ClearConsole_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>


                        <!-- PLAYSTATION 5 PROGRESSIVE BOOT LOADER OVERLAY -->
                        <!-- BOOTING SCREEN (TASKS 4.13 step 12, from the concept): staged,
                             a thin progress line, no spinner. It owns the game area until
                             the first guest frame; the embedded core window is kept hidden
                             behind it until then (see EmbedEmulatorWindow). Every colour is
                             a theme token. -->
                        <Grid x:Name="GameBootOverlay" Grid.ColumnSpan="1" Grid.RowSpan="1" Visibility="Collapsed" Background="{DynamicResource ThemeGround}">
                            <Grid Margin="56,48,56,40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Top" MaxWidth="760" HorizontalAlignment="Left">
                                    <TextBlock Text="{loc:Tr Key=ui.starting}" FontSize="{DynamicResource TypeS}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="BootGameTitle" Text="" FontSize="{DynamicResource TypeDisplayL}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" LineHeight="46" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="BootStepBadge" Text="" FontSize="{DynamicResource TypeS}" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,18"/>
                                    <Grid Width="520" HorizontalAlignment="Left" Margin="0,0,0,24">
                                        <Border Height="3" CornerRadius="{DynamicResource ThemeCornerS}" Background="{DynamicResource ThemeHairline}"/>
                                        <ProgressBar x:Name="BootProgressBar" Minimum="0" Maximum="100" Value="15" Height="3" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ThemeAccent}"/>
                                    </Grid>
                                    <TextBlock x:Name="BootProgressPercentText" Text="" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border x:Name="BootStageDot1" Width="10" Height="10" CornerRadius="{DynamicResource ThemeCornerPill}" Background="{DynamicResource ThemeHairline}" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock x:Name="BootStage1" Text="{loc:Tr Key=ui.boot_stage_core}" FontSize="{DynamicResource TypeL}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border x:Name="BootStageDot2" Width="10" Height="10" CornerRadius="{DynamicResource ThemeCornerPill}" Background="{DynamicResource ThemeHairline}" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock x:Name="BootStage2" Text="{loc:Tr Key=ui.boot_stage_package}" FontSize="{DynamicResource TypeL}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border x:Name="BootStageDot3" Width="10" Height="10" CornerRadius="{DynamicResource ThemeCornerPill}" Background="{DynamicResource ThemeHairline}" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock x:Name="BootStage3" Text="{loc:Tr Key=ui.boot_stage_executable}" FontSize="{DynamicResource TypeL}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border x:Name="BootStageDot4" Width="10" Height="10" CornerRadius="{DynamicResource ThemeCornerPill}" Background="{DynamicResource ThemeHairline}" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock x:Name="BootStage4" Text="{loc:Tr Key=ui.boot_stage_modules}" FontSize="{DynamicResource TypeL}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border x:Name="BootStageDot5" Width="10" Height="10" CornerRadius="{DynamicResource ThemeCornerPill}" Background="{DynamicResource ThemeHairline}" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock x:Name="BootStage5" Text="{loc:Tr Key=ui.boot_stage_cpu}" FontSize="{DynamicResource TypeL}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border x:Name="BootStageDot6" Width="10" Height="10" CornerRadius="{DynamicResource ThemeCornerPill}" Background="{DynamicResource ThemeHairline}" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock x:Name="BootStage6" Text="{loc:Tr Key=ui.boot_stage_frame}" FontSize="{DynamicResource TypeL}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/></StackPanel>
                                    <TextBlock x:Name="BootPhaseTitle" Text="" FontSize="{DynamicResource TypeM}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,14,0,2"/>
                                    <TextBlock x:Name="BootPhaseDetail" Text="" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,22"/>
                                    <Button x:Name="BootCancelBtn" Content="{loc:Tr Key=ui.cancel_boot}" AutomationProperties.Name="{loc:Tr Key=ui.cancel_boot}" MinWidth="160" MinHeight="44" HorizontalAlignment="Left" Style="{StaticResource ModernButtonStyle}" Click="BootCancelBtn_Click"/>
                                </StackPanel>
                                <Border Grid.Column="1" local:Theme.ClipCorners="16" Width="300" Height="300" VerticalAlignment="Top" CornerRadius="{DynamicResource ThemeCornerL}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" Background="{DynamicResource ThemeSurface}" Margin="40,0,0,0">
                                    <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.5"/></Border.Effect>
                                    <Border x:Name="BootCoverInner" Background="{DynamicResource ThemeRaised}"/>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- IN-GAME PAUSE MENU OVERLAY -->
                        <Grid x:Name="PauseMenuOverlay" Grid.ColumnSpan="1" Grid.RowSpan="1" Visibility="Collapsed" Background="#BF000000">
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5"
 CornerRadius="{DynamicResource ThemeCornerL}" Width="340" HorizontalAlignment="Center" VerticalAlignment="Center"
 Padding="0,28,0,28">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0099FF" BlurRadius="40" Opacity="0.4" ShadowDepth="0"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Header -->
                                    <TextBlock Text="P A U S E D" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}"
 HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                    <TextBlock x:Name="PauseMenuGameTitle" Text="" FontSize="{DynamicResource Type3XL}" FontWeight="ExtraBold"
 Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Center" Margin="0,0,0,24"
 TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>

                                    <!-- Menu Items -->
                                    <Button x:Name="PauseResumeBtn" Focusable="True" MinHeight="52" Margin="24,0,24,8"
 Click="PauseResume_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentSoft}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ThemeCornerM}" Padding="16,0">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶" FontSize="{DynamicResource TypeL}" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Text="{loc:Tr Key=ui.resume_game}" FontSize="{DynamicResource TypeXL}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="  [✕]" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="PauseConsoleBtn" Focusable="True" MinHeight="48" Margin="24,0,24,8"
 Click="PauseConsole_Click" Style="{StaticResource ModernButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⌨" FontSize="{DynamicResource TypeL}" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="{loc:Tr Key=ui.console_logs}" FontSize="{DynamicResource TypeL}" VerticalAlignment="Center"/>
                                            <TextBlock Text="  [△]" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="PauseStopBtn" Focusable="True" MinHeight="48" Margin="24,0,24,0"
 Click="PauseStop_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource ThemeRaised}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeRaised}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ThemeCornerM}" Padding="16,0">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeRaised}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeDanger}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeRaised}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⏹" FontSize="{DynamicResource TypeL}" Foreground="#FF6644" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="{loc:Tr Key=ui.stop_game}" FontSize="{DynamicResource TypeL}" VerticalAlignment="Center"/>
                                            <TextBlock Text="  [◯]" FontSize="{DynamicResource TypeM}" Foreground="#4DFFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{loc:Tr Key=ui.d_pad_navigate}" FontSize="{DynamicResource TypeS}" Foreground="#30FFFFFF"
 HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Bottom game bar removed in favor of global Footer actions -->
                </Grid>

            </Grid>

            <!-- FOOTER: the concept's control legend. Left, the active device's
                 hints as icon-box chips (FooterHintChips, filled by ShowHints);
                 right, a keyboard hint and the console toggle. Flat ground, top
                 hairline. Rebuilt 2026-09-06. -->
            <Border Grid.Row="2" Background="{DynamicResource ThemeGround}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Games count and status stay live for code that sets them,
                         but off the concept's clean legend bar. -->
                    <TextBlock x:Name="FooterGamesCount" Visibility="Collapsed"/>
                    <StackPanel x:Name="FooterHintChips" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="40,0,0,0"/>
                    <TextBlock x:Name="FooterGamepadHints" Visibility="Collapsed"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,40,0">
                        <TextBlock x:Name="FooterStatus" Text="{loc:Tr Key=ui.ready}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <Button x:Name="GameConsoleButton" Content="{loc:Tr Key=ui.console_2}" MinHeight="30" MinWidth="80" Padding="12,0"
 FontSize="{DynamicResource TypeS}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"
 Click="FooterConsole_Click" ToolTip="{loc:Tr Key=ui.toggle_console_log_viewer}"/>
                        <Button x:Name="GameStopButton" Content="{loc:Tr Key=ui.stop_2}" MinHeight="30" MinWidth="65" Padding="12,0"
 FontSize="{DynamicResource TypeS}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"
 Click="StopButton_Click" ToolTip="{loc:Tr Key=ui.request_graceful_stop}" Visibility="Collapsed"/>
                        <Button x:Name="GameKillButton" Content="{loc:Tr Key=ui.force_kill}" MinHeight="30" MinWidth="85" Padding="12,0"
 Foreground="{DynamicResource ThemeDanger}" FontWeight="Bold"
 FontSize="{DynamicResource TypeS}" Style="{StaticResource ModernButtonStyle}"
 Click="KillButton_Click" ToolTip="{loc:Tr Key=ui.force_terminate_process}" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WATCHDOG TOAST — non-blocking "Game may be hung" warning -->
            <!-- Stuck notice (TASKS 4.13 step 13, from the concept). Shown only when
                 frames stop after the game has drawn at least once, or when the
                 heartbeat watchdog trips; dismissed by the next frame. Never during
                 a normal boot. All colours are theme tokens. -->
            <Border x:Name="WatchdogToast" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
 Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerL}"
 Padding="22,18,22,18" Margin="0,0,40,72" Visibility="Collapsed" Opacity="0" Width="440"
 IsHitTestVisible="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="8" Height="8" CornerRadius="{DynamicResource ThemeCornerPill}" Background="{DynamicResource ThemeWarning}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="WatchdogTitle" Text="{loc:Tr Key=ui.game_may_be_unresponsive}" Foreground="{DynamicResource ThemeText}" FontSize="{DynamicResource TypeXL}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Tr Key=ui.stuck_body}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="{DynamicResource TypeM}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="WatchdogWaitBtn" Content="{loc:Tr Key=ui.wait}" AutomationProperties.Name="{loc:Tr Key=ui.wait}" MinWidth="120" MinHeight="40" Style="{StaticResource ModernButtonStyle}"
 FontSize="{DynamicResource TypeM}" Margin="0,0,8,0" Click="WatchdogWait_Click" Focusable="True"/>
                        <Button x:Name="WatchdogForceStopBtn" Content="{loc:Tr Key=ui.force_stop}" AutomationProperties.Name="{loc:Tr Key=ui.force_stop}" MinWidth="120" MinHeight="40"
 Style="{StaticResource ModernButtonStyle}" Foreground="{DynamicResource ThemeDanger}" FontSize="{DynamicResource TypeM}" FontWeight="SemiBold"
 Focusable="True" Click="WatchdogForceStop_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- TOAST NOTIFICATION OVERLAY -->
            <Border x:Name="ToastNotification" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
 Background="#CC1A1D24" BorderBrush="#3300FF99" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerM}"
 Padding="18,10" Margin="0,0,0,50" Visibility="Collapsed" Opacity="0"
 IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#00FF99" BlurRadius="20" Opacity="0.35" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Text="✓" Foreground="{DynamicResource ThemeSuccess}" FontSize="{DynamicResource TypeL}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ToastMessage" Text="{loc:Tr Key=ui.configuration_saved_successfully}" Foreground="{DynamicResource ThemeText}" FontSize="{DynamicResource TypeML}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>


            <!-- CRASH DIAGNOSTICS OVERLAY DIALOG -->
            <Grid x:Name="CrashDialogOverlay" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" Background="{DynamicResource ThemeGround}" Grid.RowSpan="3">
                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeDanger}" BorderThickness="1.5" CornerRadius="{DynamicResource ThemeCornerM}" MinWidth="580" MaxWidth="680" MinHeight="420" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF2200" BlurRadius="25" Opacity="0.4" ShadowDepth="0"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <Border Width="36" MinHeight="36" Background="{DynamicResource ThemeRaised}" CornerRadius="{DynamicResource ThemeCornerL}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="⚠" Foreground="{DynamicResource ThemeDanger}" FontSize="{DynamicResource Type4XL}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Key=ui.crash_diagnostics}" FontSize="{DynamicResource Type2XL}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                                <TextBlock Text="{loc:Tr Key=ui.guest_application_exception_detected}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeTextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Details Area -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                            <StackPanel>
                                <!-- Summary Row -->
                                <Border Background="{DynamicResource ThemeRaised}" CornerRadius="{DynamicResource ThemeCornerS}" Padding="12" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Key=ui.exception_code}" Foreground="{DynamicResource ThemeTextMuted}" FontWeight="SemiBold" FontSize="{DynamicResource TypeML}" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="CrashExcCodeText" Grid.Row="0" Grid.Column="1" Text="{loc:Tr Key=ui.0xc0000005_access_violation}" Foreground="{DynamicResource ThemeText}" FontWeight="Bold" FontSize="{DynamicResource TypeML}" Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Key=ui.address_rip}" Foreground="{DynamicResource ThemeTextMuted}" FontWeight="SemiBold" FontSize="{DynamicResource TypeML}"/>
                                        <TextBlock x:Name="CrashRipText" Grid.Row="1" Grid.Column="1" Text="0x800000080" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="{DynamicResource TypeML}"/>
                                    </Grid>
                                </Border>

                                <!-- Analysis -->
                                <TextBlock Text="{loc:Tr Key=ui.automated_analysis}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,6"/>
                                <Border Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerS}" Padding="12" Margin="0,0,0,15">
                                    <TextBlock x:Name="CrashAnalysisText" TextWrapping="Wrap" Foreground="{DynamicResource ThemeText}" FontSize="{DynamicResource TypeML}" LineHeight="18"
 Text="{loc:Tr Key=ui.the_guest_application_crashed_at_address_0x8}"/>
                                </Border>

                                <!-- Raw Logs -->
                                <TextBlock Text="{loc:Tr Key=ui.crash_dump_extract}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                                <TextBox x:Name="CrashRawText" IsReadOnly="True" Background="{DynamicResource ThemeRaised}" Foreground="{DynamicResource ThemeTextMuted}" BorderThickness="0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="{DynamicResource TypeS}" Padding="8" MinHeight="80" MaxHeight="220" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Buttons -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Tr Key=ui.copy}" MinWidth="70" MinHeight="32" Padding="12,0" Style="{StaticResource SecondaryButtonStyle}" Click="CopyCrashToClipboard_Click" Margin="0,0,6,0"/>
                            <Button Content="{loc:Tr Key=ui.raw_logs}" MinWidth="80" MinHeight="32" Padding="12,0" Style="{StaticResource SecondaryButtonStyle}" Click="ViewCrashRawLogs_Click" Margin="0,0,6,0"/>
                            <Button Content="{loc:Tr Key=ui.dismiss}" MinWidth="70" MinHeight="32" Padding="12,0" Style="{StaticResource SecondaryButtonStyle}" Click="DismissCrashDialog_Click" Margin="0,0,6,0"/>
                            <Button Content="{loc:Tr Key=ui.boot_analyzer_2}" MinWidth="110" MinHeight="32" Padding="14,0" Style="{StaticResource ModernButtonStyle}" Click="AnalyzeCrashedGame_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- CUSTOM COLOUR POPUP: the picker, driven by the sticks -->
            <Grid x:Name="ColorPickerOverlay" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" Background="#CC000000" Grid.RowSpan="3">
                <Border Background="{DynamicResource ThemeRaised}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerL}" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=colorpicker.title}" FontSize="{DynamicResource Type3XL}" FontWeight="ExtraBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,16"/>
                        <local:ColorPickerControl x:Name="PopupPicker"/>
                        <!-- Footer: stick hints left, the two buttons right (their labels carry the glyphs). -->
                        <Border BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
                            <Grid>
                                <StackPanel x:Name="ColorPickerHintChips" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ColorPickerCancelBtn" Content="{loc:Tr Key=colorpicker.cancel}" MinHeight="40" Padding="16,8" FontSize="{DynamicResource TypeS}" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="ColorPickerCancel_Click" AutomationProperties.Name="{loc:Tr Key=colorpicker.cancel}"/>
                            <Button x:Name="ColorPickerApplyBtn" Content="{loc:Tr Key=colorpicker.apply}" MinHeight="40" Padding="20,0" Style="{StaticResource ModernButtonStyle}" Click="ColorPickerApply_Click" AutomationProperties.Name="{loc:Tr Key=colorpicker.apply}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- UPDATE PROMPT: a new build is on GitHub -->
            <Grid x:Name="UpdateOverlay" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" Background="#CC000000" Grid.RowSpan="3">
                <Border Background="{DynamicResource ThemeRaised}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerL}" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=update.title}" FontSize="{DynamicResource Type3XL}" FontWeight="ExtraBold" Foreground="{DynamicResource ThemeText}"/>
                        <TextBlock x:Name="UpdateBodyText" TextWrapping="Wrap" FontSize="{DynamicResource TypeML}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,8,0,18"/>
                        <Grid x:Name="UpdateProgressRow" Visibility="Collapsed" Margin="0,0,0,18">
                            <Border Height="6" CornerRadius="{DynamicResource ThemeCornerS}" Background="{DynamicResource ThemeHairline}"/>
                            <Border x:Name="UpdateProgressFill" Height="6" Width="0" HorizontalAlignment="Left" CornerRadius="{DynamicResource ThemeCornerS}" Background="{DynamicResource ThemeAccent}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="UpdateSkipBtn" Content="{loc:Tr Key=update.skip}" MinHeight="40" Padding="16,0" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="UpdateSkip_Click" AutomationProperties.Name="{loc:Tr Key=update.skip}"/>
                            <Button x:Name="UpdateLaterBtn" Content="{loc:Tr Key=update.later}" MinHeight="40" Padding="16,0" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="UpdateLater_Click" AutomationProperties.Name="{loc:Tr Key=update.later}"/>
                            <Button x:Name="UpdateInstallBtn" Content="{loc:Tr Key=update.install}" MinHeight="40" Padding="20,0" Style="{StaticResource ModernButtonStyle}" Click="UpdateInstall_Click" AutomationProperties.Name="{loc:Tr Key=update.install}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CREDITS POPUP: the README's Credits section, pad-scrollable -->
            <Grid x:Name="CreditsOverlay" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" Background="#CC000000" Grid.RowSpan="3">
                <Border Background="{DynamicResource ThemeRaised}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerL}" Width="960" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Key=credits.title}" FontSize="{DynamicResource Type3XL}" FontWeight="ExtraBold" Foreground="{DynamicResource ThemeText}"/>
                                <TextBlock Text="{loc:Tr Key=credits.subtitle}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="CreditsCloseBtn" Style="{StaticResource SecondaryButtonStyle}" Width="40" Height="40" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CreditsClose_Click" ToolTip="{loc:Tr Key=credits.close}" AutomationProperties.Name="{loc:Tr Key=credits.close}">
                                <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="{DynamicResource ThemeText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="None"/>
                            </Button>
                        </Grid>
                        <ScrollViewer x:Name="CreditsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="CreditsText" TextWrapping="Wrap" FontSize="{DynamicResource TypeML}" LineHeight="24" Foreground="{DynamicResource ThemeText}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- FIRST-RUN SETUP OVERLAY DIALOG (games folder picker) -->
            <Grid x:Name="FirstRunOverlay" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" Background="{DynamicResource ThemeGround}" Grid.RowSpan="3">
                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="{DynamicResource ThemeCornerM}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                    <Border.Effect>
                        <DropShadowEffect Color="#0099FF" BlurRadius="25" Opacity="0.35" ShadowDepth="0"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=ui.welcome_to_pcsx5}" FontSize="{DynamicResource Type5XL}" FontWeight="ExtraBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#FFA0A0A5" FontSize="{DynamicResource TypeL}" LineHeight="20" Margin="0,0,0,18"
 Text="{loc:Tr Key=ui.before_you_start_choose_the_folder_where_you}"/>

                        <TextBlock Text="{loc:Tr Key=ui.games_folder}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#20FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerS}" Padding="10,6">
                                <TextBlock x:Name="FirstRunFolderText" Text="{loc:Tr Key=ui.no_folder_selected}" Foreground="White" FontSize="{DynamicResource TypeML}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Button Grid.Column="1" Content="{loc:Tr Key=ui.browse}" MinWidth="100" MinHeight="32" Margin="10,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="FirstRunBrowse_Click"/>
                        </Grid>

                        <!-- Controller hint -->
                        <TextBlock Text="{loc:Tr Key=ui.browse_folder_skip_continue}" FontSize="{DynamicResource TypeM}" Foreground="#4D0099FF"
 HorizontalAlignment="Center" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="FirstRunSkipBtn" Content="{loc:Tr Key=ui.skip_for_now}" MinWidth="120" MinHeight="34" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="FirstRunSkip_Click" Focusable="True"/>
                            <Button x:Name="FirstRunContinueBtn" Content="{loc:Tr Key=ui.continue}" MinWidth="140" MinHeight="34" Style="{StaticResource ModernButtonStyle}" IsEnabled="False" Click="FirstRunContinue_Click" Focusable="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CONTROLLER FOLDER PICKER OVERLAY
                 Shows before opening the system folder browser dialog. -->

            <!-- In-app directory browser.  A Windows folder dialog cannot be
                 driven by a controller at all, so the shell browses the
                 filesystem itself.  All text is assigned from I18n at runtime,
                 which is why Content/Text are empty here. -->
            <!-- FOLDER PICKER OVERLAY - rebuilt to the concept artboard 2026-09-06.
                 A centred card on a dimmed ground: header + eboot note, a mono
                 breadcrumb, quick drive chips, an eboot-aware directory list, a
                 Cancel / Add pair, and a controller glyph legend along the bottom.
                 A Windows folder dialog cannot be driven by a controller, so the
                 shell browses the filesystem itself. Text is assigned from I18n at
                 runtime. Flat theme tokens, no accent glow. -->
            <!-- CONTROLLER TESTING POPUP - the Input tab's Testing view. While it is
                 open the pad is captured: nothing switches tabs or sub-tabs, so every
                 button (L1/R1/L2/R2 included) can be tested. Dismiss with the PS button,
                 the Close button, or Esc. Added 2026-09-06 at the user's request. -->
            <Grid x:Name="InputTestOverlay" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" Background="#B305060A" Grid.RowSpan="3">
                <Border x:Name="InputTestCard" Width="1180" Height="780" HorizontalAlignment="Center" VerticalAlignment="Center"
 Background="{DynamicResource ThemeRaised}" BorderBrush="{DynamicResource ThemeBorderStrong}"
 BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerL}" Padding="28">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="InputTestCardOffset"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="60" ShadowDepth="20" Direction="270" Opacity="0.55"/>
                    </Border.Effect>
                    <DockPanel LastChildFill="True">
                        <!-- The header is the drag handle: press and move it to place the popup. -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16" Background="Transparent" Cursor="SizeAll"
                              MouseLeftButtonDown="InputTestHeader_MouseDown" MouseMove="InputTestHeader_MouseMove" MouseLeftButtonUp="InputTestHeader_MouseUp">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="{loc:Tr Key=input.test_popup_title}" FontSize="{DynamicResource TypeDisplayS}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                                <TextBlock Text="{loc:Tr Key=input.test_popup_hint}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="InputTestCloseBtn" Style="{StaticResource SecondaryButtonStyle}" Width="40" Height="40" Padding="0"
 HorizontalAlignment="Right" VerticalAlignment="Top" Click="InputTestClose_Click" ToolTip="{loc:Tr Key=input.test_popup_close}"
 AutomationProperties.Name="{loc:Tr Key=input.test_popup_close}">
                                <!-- a drawn cross, not a glyph: identical in every font and theme -->
                                <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="{DynamicResource ThemeText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="None"/>
                            </Button>
                        </Grid>
                        <local:InputTabView x:Name="InputTab"/>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid x:Name="FolderPickerOverlay" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" Background="#B305060A" Grid.RowSpan="3">
                <Border Width="860" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center"
 Background="{DynamicResource ThemeRaised}" BorderBrush="{DynamicResource ThemeBorderStrong}"
 BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerL}" Padding="32">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="60" ShadowDepth="20" Direction="270" Opacity="0.55"/>
                    </Border.Effect>
                    <DockPanel LastChildFill="True">
                        <!-- Header: title left, eboot note right -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock x:Name="FolderPickerTitle" FontSize="{DynamicResource TypeDisplayL}" FontWeight="Bold"
 Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="FolderPickerSubtitle" FontSize="{DynamicResource TypeM}"
 Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>

                        <!-- Mono breadcrumb of the current path (built in code) -->
                        <StackPanel x:Name="FolderPickerBreadcrumb" DockPanel.Dock="Top" Orientation="Horizontal"
 Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <!-- Quick drive chips (built in code) -->
                        <StackPanel x:Name="FolderPickerDriveChips" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14"/>

                        <!-- Controller glyph legend (built in code from picker.hints) -->
                        <StackPanel x:Name="FolderPickerHintChips" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0"/>

                        <!-- Cancel / Add -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="FolderPickerCancelBtn" MinWidth="120" MinHeight="46" Margin="0,0,12,0"
 Style="{StaticResource SecondaryButtonStyle}" Click="FolderPickerCancel_Click" Focusable="True"/>
                            <Button x:Name="FolderPickerSelectBtn" MinWidth="180" MinHeight="46"
 Style="{StaticResource ModernButtonStyle}" Click="FolderPickerSelect_Click" Focusable="True"/>
                        </StackPanel>

                        <!-- Legacy controls kept for code that assigns them; not shown. -->
                        <TextBlock x:Name="FolderPickerCurrentPath" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
                        <TextBlock x:Name="FolderPickerHints" DockPanel.Dock="Bottom" Visibility="Collapsed"/>

                        <!-- Directory list, hairline-bounded top and bottom -->
                        <Border BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="0,1,0,1" Padding="0,6">
                            <ListBox x:Name="FolderPickerList" FocusVisualStyle="{StaticResource AccentFocusVisual}"
 Background="Transparent" BorderThickness="0"
 Foreground="{DynamicResource ThemeText}"
 MouseDoubleClick="FolderPickerList_MouseDoubleClick"
 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent"
 BorderThickness="2" CornerRadius="{DynamicResource ThemeCornerM}" Padding="14,0" Margin="0,1">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeRaised}"/>
                                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="52">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <Path StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="M2,5.5 A1.5,1.5 0 0 1 3.5,4 H7.5 L9,5.5 H14.5 A1.5,1.5 0 0 1 16,7 V13.5 A1.5,1.5 0 0 1 14.5,15 H3.5 A1.5,1.5 0 0 1 2,13.5 Z"/>
                                                            <Setter Property="Stroke" Value="{DynamicResource ThemeTextMuted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGame}" Value="True">
                                                                    <Setter Property="Data" Value="M4,3 H14 A1,1 0 0 1 15,4 V14 A1,1 0 0 1 14,15 H4 A1,1 0 0 1 3,14 V4 A1,1 0 0 1 4,3 Z M6,9 H12 M9,6 V12"/>
                                                                    <Setter Property="Stroke" Value="{DynamicResource ThemeAccent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Viewbox>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
 FontSize="{DynamicResource TypeL}" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Meta}" VerticalAlignment="Center"
 FontSize="{DynamicResource TypeS}" FontFamily="Consolas, monospace"
 Foreground="{DynamicResource ThemeTextMuted}" Margin="12,0,4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
