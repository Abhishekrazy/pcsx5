<Window x:Class="Pcsx5Ui.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Pcsx5Ui"
        xmlns:local="clr-namespace:Pcsx5Ui"
 Title="PCSX5 - PlayStation 5 Emulator" Height="780" Width="1200"
 MinWidth="1050" MinHeight="680"
 WindowStartupLocation="CenterScreen"
 Background="#0A0D14"
 Foreground="White"
 FontFamily="Segoe UI Semibold, Inter, Outfit, Arial"
 Loaded="Window_Loaded"
 PreviewKeyDown="Window_PreviewKeyDown"
 Icon="pcsx5_icon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" 
 CornerRadius="12" 
 CaptionHeight="50" 
 ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Windows 11 style global resources -->
        <SolidColorBrush x:Key="SystemAccentBrush" Color="#0099FF"/>
        <SolidColorBrush x:Key="AccentGlowBrush" Color="#3F0099FF"/>
        <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#CC0A0D14"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#3F000000"/>

        <!-- Controller input overlay styles: hidden until the matching button is pressed -->
        <Style x:Key="PadOverlayStyle" TargetType="Shape">
            <Setter Property="Fill" Value="#550099FF"/>
            <Setter Property="Stroke" Value="#0099FF"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style x:Key="PadOverlayRingStyle" TargetType="Shape">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="#0099FF"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        
        <!-- Navigation tab button style -->
        <Style x:Key="NavTabButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFA0A0A5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="20,0,20,0"/>
            <Setter Property="Margin" Value="5,0,5,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}" 
 Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8,15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}" 
 CornerRadius="6"
 Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3DFFFFFF"/>
                    <Setter Property="BorderBrush" Value="#4FFFFFFF"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#3F0099FF"/>
                    <Setter Property="BorderBrush" Value="#0099FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Background" Value="#1F242F"/>
            <Setter Property="Foreground" Value="#FFA0A0A5"/>
            <Setter Property="BorderBrush" Value="#2A2F3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,5,15,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2F3D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#3F0099FF"/>
                    <Setter Property="BorderBrush" Value="#0099FF"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Global Controller Focus Style for ComboBox, Slider, CheckBox -->
        <Style TargetType="ComboBox">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0099FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#3F0099FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="#0099FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- PS5 Console Theme Styles for Multi-Page Settings -->
        <Style x:Key="Ps5HubTileStyle" TargetType="Button">
            <Setter Property="Background" Value="#121622"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder" Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}" 
 CornerRadius="14" Padding="16,14">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#1A2234"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#400099FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#200070D1"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#0099FF"/>
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ps5SettingRowStyle" TargetType="Button">
            <Setter Property="Background" Value="#10141E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder" Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}" 
 CornerRadius="12" Padding="18,12">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#1A2030"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#300099FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#250070D1"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#0099FF"/>
                                <Setter TargetName="RowBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ps5OptionItemStyle" TargetType="Button">
            <Setter Property="Background" Value="#121622"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OptionBorder" Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}" 
 CornerRadius="12" Padding="20,14">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#1E2638"/>
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#400099FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#280070D1"/>
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#0099FF"/>
                                <Setter TargetName="OptionBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ps5PillToggleStyle" TargetType="Button">
            <Setter Property="Background" Value="#161B28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Margin" Value="8,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}" 
 CornerRadius="12" Padding="24,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#222A3E"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#400099FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#300070D1"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#0099FF"/>
                                <Setter TargetName="PillBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings Card / Row Tile Style (Android TV Card Style) -->
        <Style x:Key="SettingsCardTileStyle" TargetType="Border">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <!-- Animated spinner keyframe -->
        <Style x:Key="SpinnerStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="#0099FF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Immersive Full Window Background Image with opacity -->
        <Image x:Name="WindowBgImage" Stretch="UniformToFill" Opacity="0.28" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image.Effect>
                <BlurEffect Radius="15" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>
        
        <!-- Bottom scrim: keeps title/metadata legible over arbitrary key art. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0005060A" Offset="0.35"/>
                    <GradientStop Color="#9905060A" Offset="0.72"/>
                    <GradientStop Color="#E605060A" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Dark gradient overlay to fade the background art to black at the edges -->
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <LinearGradientBrush.GradientStops>
                        <GradientStop Color="#8F0A0D14" Offset="0.0"/>
                        <GradientStop Color="#BF0A0D14" Offset="0.6"/>
                        <GradientStop Color="#FD05060A" Offset="1.0"/>
                    </LinearGradientBrush.GradientStops>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- Main Window Layout -->
        <Grid x:Name="MainLayoutRoot" Margin="0">
            <Grid.RowDefinitions>
                <!-- Title Bar & Navigation -->
                <RowDefinition Height="65"/>
                <!-- Content Area -->
                <RowDefinition Height="*"/>
                <!-- Status/Footer Bar -->
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Title Bar & Navigation Grid -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#4F05060A" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="PCSX5" Foreground="#0099FF" FontSize="{DynamicResource Type4XL}" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                        <TextBlock Text="PS5" Foreground="#A0A0A5" FontSize="{DynamicResource TypeM}" Margin="8,4,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Navigation Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="TabLibraryBtn" Content="{loc:Tr Key=ui.game_library}" Style="{StaticResource NavTabButtonStyle}" Click="TabLibrary_Click"/>
                        <Button x:Name="TabAnalyzerBtn" Content="{loc:Tr Key=ui.boot_analyzer}" Style="{StaticResource NavTabButtonStyle}" Click="TabAnalyzer_Click"/>
                        <Button x:Name="TabControllerBtn" Content="{loc:Tr Key=ui.controller_setup}" Style="{StaticResource NavTabButtonStyle}" Click="TabController_Click"/>
                        <Button x:Name="TabSettingsBtn" Content="{loc:Tr Key=ui.system_settings}" Style="{StaticResource NavTabButtonStyle}" Click="TabSettings_Click"/>
                    </StackPanel>

                    <!-- Top-Right Controls & Search Box -->
                    <Grid Grid.Column="2" VerticalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <!-- Universal HUD: Performance metrics (FPS, RAM, Host CPU) -->
                            <StackPanel x:Name="HudMetricsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0" Visibility="Collapsed">
                                <TextBlock x:Name="HudFpsText" Text="FPS: --" FontSize="{DynamicResource TypeM}" Foreground="#50DD60" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="|" Foreground="#25FFFFFF" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HudRamText" Text="RAM: -- MB" FontSize="{DynamicResource TypeM}" Foreground="#FFA0A0A5" VerticalAlignment="Center"/>
                                <TextBlock Text="|" Foreground="#25FFFFFF" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HudVramText" Text="VRAM: -- MB" FontSize="{DynamicResource TypeM}" Foreground="#FFA0A0A5" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="BtnMinimize" Content="⚊" MinWidth="42" MinHeight="26" Background="Transparent" Foreground="#D0FFFFFF" BorderThickness="0" FontSize="{DynamicResource TypeM}" Click="Minimize_Click" Style="{x:Null}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnMaximize" Content="🗖" MinWidth="42" MinHeight="26" Background="Transparent" Foreground="#D0FFFFFF" BorderThickness="0" FontSize="{DynamicResource TypeS}" Click="Maximize_Click" Style="{x:Null}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnClose" Content="✕" MinWidth="42" MinHeight="26" Background="Transparent" Foreground="#D0FFFFFF" BorderThickness="0" FontSize="{DynamicResource TypeM}" Click="Close_Click" Style="{x:Null}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Search box below controls -->
                        <Grid Width="200" Height="30" Margin="0,0,25,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" WindowChrome.IsHitTestVisibleInChrome="True">
                            <!-- Background Pill -->
                            <Border x:Name="SearchBoxBorder" CornerRadius="15" Background="#2FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Search Icon -->
                                    <TextBlock Grid.Column="0" Text="🔍" Foreground="#FFA0A0A5" FontSize="{DynamicResource TypeM}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- TextBox -->
                                    <TextBox x:Name="SearchBox" FocusVisualStyle="{StaticResource AccentFocusVisual}" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="0,0,10,0" FontSize="{DynamicResource TypeM}" FontWeight="SemiBold" GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" TextChanged="SearchBox_TextChanged"/>
                                    <!-- Placeholder Text -->
                                    <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="{loc:Tr Key=ui.search_games}" Foreground="#6FA0A0A5" FontSize="{DynamicResource TypeM}" VerticalAlignment="Center" Padding="0,0,10,0" IsHitTestVisible="False" Visibility="Visible"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- CONTENT VIEWS -->
            <Grid Grid.Row="1">
                
                <!-- 1. GAME LIBRARY VIEW (GRID) -->
                <Grid x:Name="LibraryView" Visibility="Visible" Margin="0">
                    <Grid.RowDefinitions>
                        <!-- Upper details area -->
                        <RowDefinition Height="*"/>
                        <!-- Lower carousel shelf -->
                        <RowDefinition Height="420"/>
                    </Grid.RowDefinitions>

                    <!-- Upper details area: details about selected game -->
                    <Grid Grid.Row="0" Margin="40,25,40,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/> <!-- Text Details -->
                            <ColumnDefinition Width="1*"/>   <!-- Mini Cover Display -->
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Big Game Title & Play Controls.
                             Bottom-anchored so the title and its action sit
                             directly above the tile row, as on the PS5 home
                             screen, rather than centred with dead space below. -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,0,26">
                            <!-- Game Title -->
                            <TextBlock x:Name="DetailTitle" Text="{loc:Tr Key=ui.select_a_game}" FontSize="{DynamicResource TypeDisplayL}" FontWeight="ExtraBold" Foreground="White" TextWrapping="Wrap" LineHeight="48"/>
                            
                            <!-- Metadata badges & ID -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,20">
                                <TextBlock x:Name="DetailTitleId" Text="{loc:Tr Key=ui.no_game_selected}" FontSize="{DynamicResource TypeL}" Foreground="#FFA0A0A5" VerticalAlignment="Center"/>
                                <TextBlock Text="•" Foreground="#FFA0A0A5" Margin="10,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DetailSize" Text="-" FontSize="{DynamicResource TypeL}" Foreground="#FFA0A0A5" VerticalAlignment="Center"/>
                                <TextBlock Text="•" Foreground="#FFA0A0A5" Margin="10,0,10,0" VerticalAlignment="Center"/>
                                
                                <Border x:Name="DetailCompatBadge" Padding="8,3,8,3" CornerRadius="4" Background="#3F555555" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailCompatText" Text="{loc:Tr Key=ui.unknown}" FontSize="{DynamicResource TypeS}" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <!-- Path info: present for developers, deliberately
                                 quiet. A full filesystem path shouting at the
                                 user is the opposite of a console dashboard. -->
                            <TextBlock x:Name="DetailPath" Text="-" FontSize="{DynamicResource TypeS}"
                                       Foreground="#59A0A0A5" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Margin="0,0,0,22"/>

                            <!-- Play/Launch Button -->
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LaunchButton" Content="{loc:Tr Key=ui.play_game}" MinWidth="200" MinHeight="48" FontSize="{DynamicResource TypeXL}" FontWeight="Bold" Cursor="Hand" Click="LaunchButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="24" BorderBrush="#3FFFFFFF" BorderThickness="1">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#0078D4" BlurRadius="15" Opacity="0.5" ShadowDepth="0"/>
                                                            </Border.Effect>
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#0099FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="StopButton" Content="{loc:Tr Key=ui.stop}" MinWidth="100" MinHeight="48" FontSize="{DynamicResource TypeXL}" FontWeight="Bold" Margin="15,0,0,0" Cursor="Hand" Visibility="Collapsed" Click="StopButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#CC2200"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="24" BorderBrush="#3FFFFFFF" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF3300"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Column: Visual Art Preview of Selected Game -->
                        <Border x:Name="GameCoverDisplayBorder" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,0" Width="300" MinHeight="300" CornerRadius="16" BorderBrush="#2FFFFFFF" BorderThickness="1" Background="#1F000000"/>
                    </Grid>

                    <!-- Lower Carousel shelf: horizontal scrolling game icons -->
                    <Grid x:Name="LibraryCarousel" Grid.Row="1" Background="#2F05060A">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="40,15,40,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LibraryHeaderTextBlock" Grid.Column="0" Text="{loc:Tr Key=ui.game_library_2}" FontSize="{DynamicResource TypeL}" FontWeight="Bold" Foreground="#FFA0A0A5" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LibraryGameCount" Text="{loc:Tr Key=ui.0_games}" FontSize="{DynamicResource TypeM}" Foreground="#6FA0A0A5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button x:Name="FullLibraryToggleBtn" Content="{loc:Tr Key=ui.view_all}" MinWidth="110" MinHeight="28" FontSize="{DynamicResource TypeS}" Style="{StaticResource ModernButtonStyle}" Click="ToggleFullLibrary_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="LibraryScroller" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Style="{StaticResource ModernScrollViewer}" Padding="35,0,10,0">
                                <StackPanel x:Name="GamesWrapPanel" Orientation="Horizontal" VerticalAlignment="Center" Height="320"/>
                            </ScrollViewer>

                            <!-- Scroll arrows -->
                            <Button x:Name="LibraryScrollLeft" Content="◀" MinWidth="52" MinHeight="52" HorizontalAlignment="Left" VerticalAlignment="Center"
 Background="#59000000" Foreground="White" FontSize="{DynamicResource TypeL}" BorderThickness="0" Margin="8,0,0,0"
 Visibility="Collapsed" Click="LibraryScrollLeft_Click" Panel.ZIndex="10"/>
                            <Button x:Name="LibraryScrollRight" Content="▶" MinWidth="52" MinHeight="52" HorizontalAlignment="Right" VerticalAlignment="Center"
 Background="#59000000" Foreground="White" FontSize="{DynamicResource TypeL}" BorderThickness="0" Margin="0,0,8,0"
 Visibility="Collapsed" Click="LibraryScrollRight_Click" Panel.ZIndex="10"/>
                        </Grid>

                        <!-- Spacer -->
                        <Border Grid.Row="2" MinHeight="10"/>
                    </Grid>

                    <!-- Full library grid view (hidden by default) -->
                    <Grid x:Name="FullLibraryGrid" Grid.Row="1" Visibility="Collapsed" Background="#2F05060A" Margin="40,15,40,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="FullLibraryBackBtn" Content="{loc:Tr Key=ui.back_to_carousel}" MinWidth="140" MinHeight="28" FontSize="{DynamicResource TypeS}" Style="{StaticResource ModernButtonStyle}" Click="ToggleFullLibrary_Click"/>
                                <TextBox x:Name="LibrarySearchBox" Width="200" Height="28" Margin="12,0,0,0" FontSize="{DynamicResource TypeM}" Background="#2F000000" Foreground="White" BorderBrush="#3FFFFFFF" BorderThickness="1"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="FullLibraryCount" Text="{loc:Tr Key=ui.0_games}" FontSize="{DynamicResource TypeM}" Foreground="#6FA0A0A5" VerticalAlignment="Center"/>
                        </Grid>
                        <ListView x:Name="FullLibraryListView" FocusVisualStyle="{StaticResource AccentFocusVisual}" Grid.Row="1" Background="Transparent" Foreground="White" BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{loc:Tr Key=ui.title}" Width="250" DisplayMemberBinding="{Binding Title}"/>
                                    <GridViewColumn Header="{loc:Tr Key=ui.title_id}" Width="110" DisplayMemberBinding="{Binding TitleId}"/>
                                    <GridViewColumn Header="{loc:Tr Key=ui.size}" Width="90" DisplayMemberBinding="{Binding SizeStr}"/>
                                    <GridViewColumn Header="{loc:Tr Key=ui.status}" Width="100" DisplayMemberBinding="{Binding CompatStatus}"/>
                                    <GridViewColumn Header="{loc:Tr Key=ui.path}" Width="200" DisplayMemberBinding="{Binding EbootPath}"/>
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Margin" Value="0,1,0,1"/>
                                    <Setter Property="Padding" Value="4,4,4,4"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3F0099FF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#20FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Grid>
                
                <!-- 1.5. BOOT ANALYZER VIEW (GRID) -->
                <Grid x:Name="AnalyzerView" Visibility="Collapsed" Margin="40,20,40,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top Buttons -->
                        <RowDefinition Height="*"/>    <!-- Main Split Area -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="AnalyzerHeaderTextBlock" Text="{loc:Tr Key=ui.executable_boot_amp_memory_analyzer}" FontSize="{DynamicResource TypeL}" FontWeight="Bold" Foreground="#FFA0A0A5" VerticalAlignment="Center"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Tr Key=ui.analyze_all_games}" Style="{StaticResource ModernButtonStyle}" Click="AnalyzeAll_Click"/>
                            <Button Content="{loc:Tr Key=ui.export_minimal_summary}" Style="{StaticResource ModernButtonStyle}" Margin="10,0,0,0" Click="ExportSummary_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/> <!-- Left: ListView -->
                            <ColumnDefinition Width="1.2*"/> <!-- Right: Selected Game Details / Log -->
                        </Grid.ColumnDefinitions>

                        <!-- ListView -->
                        <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                            <ListView x:Name="AnalyzerListView" FocusVisualStyle="{StaticResource AccentFocusVisual}" Background="Transparent" Foreground="White" BorderThickness="0" SelectionChanged="AnalyzerListView_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{loc:Tr Key=ui.game_title}" Width="220" DisplayMemberBinding="{Binding Title}"/>
                                        <GridViewColumn Header="{loc:Tr Key=ui.title_id}" Width="110" DisplayMemberBinding="{Binding TitleId}"/>
                                        <GridViewColumn Header="{loc:Tr Key=ui.format}" Width="210" DisplayMemberBinding="{Binding Format}"/>
                                        <GridViewColumn Header="{loc:Tr Key=ui.encryption}" Width="210" DisplayMemberBinding="{Binding EncryptionStatus}"/>
                                        <GridViewColumn Header="{loc:Tr Key=ui.footprint}" Width="120" DisplayMemberBinding="{Binding MemoryFootprint}"/>
                                        <GridViewColumn Header="{loc:Tr Key=ui.alignment}" Width="260" DisplayMemberBinding="{Binding AlignmentStatus}"/>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Margin" Value="0,2,0,2"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#3F0099FF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#20FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Border>

                        <!-- Raw Log View on the Right -->
                        <Border Grid.Column="1" Background="#E0050508" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{loc:Tr Key=ui.detailed_parser_analysis_log}" FontSize="{DynamicResource TypeM}" Foreground="#FFA0A0A5" Margin="0,0,0,8"/>
                                <TextBox x:Name="AnalyzerOutputTextBox" Grid.Row="1" Background="Transparent" Foreground="#FFCC66" FontFamily="Consolas, Courier New" FontSize="10.5" 
 BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" AcceptsReturn="True"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                
                <!-- 1.7. CONTROLLER SETUP VIEW (GRID) -->
                <Grid x:Name="ControllerView" Visibility="Collapsed" Margin="40,10,40,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Tr Key=ui.controller_setup_2}" FontSize="{DynamicResource TypeL}" FontWeight="Bold" Foreground="#FFA0A0A5" Margin="0,0,0,5"/>

                    <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Left side mapping (D-Pad, L1/L2, Left Stick, Deadzone) -->
                                <ColumnDefinition Width="260"/>
                                <!-- Center side (Config Selection, DualSense Image, Touchpad, Color, Save buttons) -->
                                <ColumnDefinition Width="*"/>
                                <!-- Right side mapping (Face buttons, R1/R2, Right Stick, Deadzone) -->
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <!-- COLUMN 0: LEFT SIDE MAPPINGS -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,10,0">
                                    <!-- D-PAD CARD -->
                                    <Border Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Key=ui.d_pad}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,8"/>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.up}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapUp" Tag="PadUp|pad_up" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.left}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapLeft" Tag="PadLeft|pad_left" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.right}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapRight" Tag="PadRight|pad_right" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.down}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapDown" Tag="PadDown|pad_down" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- L1 and L2 CARD -->
                                    <Border Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Key=ui.l1_and_l2}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,8"/>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="L1" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapL1" Tag="L1|l1" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="L2" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapL2" Tag="L2|l2" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- LEFT STICK DEADZONE CARD -->
                                    <Border Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Key=ui.left_stick_deadzone}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,8"/>
                                            <TextBlock Text="{loc:Tr Key=ui.min_deadzone_def_2_max_127}" FontSize="{DynamicResource TypeS}" Foreground="#FFA0A0A5" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="CtrlMinDeadzoneLSlider" FocusVisualStyle="{StaticResource AccentFocusVisual}" Minimum="0" Maximum="127" Value="2" TickFrequency="5" IsSnapToTickEnabled="True" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ElementName=CtrlMinDeadzoneLSlider, Path=Value}" Foreground="White" FontWeight="Bold" FontSize="{DynamicResource TypeS}" HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="{loc:Tr Key=ui.max_deadzone_def_127_max_127}" FontSize="{DynamicResource TypeS}" Foreground="#FFA0A0A5" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="CtrlMaxDeadzoneLSlider" FocusVisualStyle="{StaticResource AccentFocusVisual}" Minimum="0" Maximum="127" Value="127" TickFrequency="5" IsSnapToTickEnabled="True" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ElementName=CtrlMaxDeadzoneLSlider, Path=Value}" Foreground="White" FontWeight="Bold" FontSize="{DynamicResource TypeS}" HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- LEFT STICK CARD -->
                                    <Border Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Key=ui.left_stick}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,8"/>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.up}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapLeftStickUp" Tag="LeftStickUp|axis_left_y" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.left}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapLeftStickLeft" Tag="LeftStickLeft|axis_left_x" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.right}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapLeftStickRight" Tag="LeftStickRight|axis_left_x" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.down}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapLeftStickDown" Tag="LeftStickDown|axis_left_y" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- COLUMN 1: CENTER AREA -->
                            <Grid Grid.Column="1" Margin="10,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Config selection -->
                                    <RowDefinition Height="*"/>    <!-- PS5 image -->
                                    <RowDefinition Height="Auto"/> <!-- Bottom buttons (L3, Options, R3, etc.) -->
                                    <RowDefinition Height="Auto"/> <!-- Color adjustment -->
                                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Live Input Tester panel -->
                                </Grid.RowDefinitions>

                                <!-- Config Selection Card -->
                                <Border Grid.Row="0" Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Text="{loc:Tr Key=ui.config_selection}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                            <ComboBox x:Name="CtrlConfigCombo" FocusVisualStyle="{StaticResource AccentFocusVisual}" SelectedIndex="0" Width="140" Height="24" Background="#2FFFFFFF" Foreground="Black">
                                                <ComboBoxItem Content="{loc:Tr Key=ui.common_config}"/>
                                            </ComboBox>
                                            <CheckBox x:Name="CtrlUsePerGameConfigCheck" FocusVisualStyle="{StaticResource AccentFocusVisual}" Content="{loc:Tr Key=ui.use_per_game_configs}" Foreground="White" Margin="15,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                            <TextBlock Text="{loc:Tr Key=ui.active_gamepad}" Foreground="#FFA0A0A5" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}" Margin="0,0,10,0"/>
                                            <ComboBox x:Name="CtrlActiveGamepadCombo" FocusVisualStyle="{StaticResource AccentFocusVisual}" SelectedIndex="0" Width="200" Height="24" Background="#2FFFFFFF" Foreground="Black" SelectionChanged="CtrlActiveGamepadCombo_SelectionChanged">
                                                <ComboBoxItem Content="{loc:Tr Key=ui.player_1_dualsense_wireless_controller}"/>
                                                <ComboBoxItem Content="{loc:Tr Key=ui.player_2_controller_slot_2}"/>
                                                <ComboBoxItem Content="{loc:Tr Key=ui.player_3_controller_slot_3}"/>
                                                <ComboBoxItem Content="{loc:Tr Key=ui.player_4_controller_slot_4}"/>
                                                <ComboBoxItem Content="{loc:Tr Key=ui.xbox_controller_xinput}"/>
                                            </ComboBox>
                                            <Button Content="{loc:Tr Key=ui.set_active_gamepad_as_default}" Style="{StaticResource ModernButtonStyle}" MinHeight="24" FontSize="{DynamicResource TypeS}" Padding="8,0,8,0" Margin="10,0,0,0" Click="SaveSettingsBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Controller Image with live input overlays (1017x1017 design space, scaled by the Viewbox) -->
                                <Grid Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="260">
                                    <Viewbox Stretch="Uniform">
                                        <Grid Width="1017" Height="1017">
                                            <Image Source="ps5_controller.png" Stretch="Uniform" Opacity="0.85"/>
                                            <Canvas x:Name="ControllerOverlayCanvas" Width="1017" Height="1017" IsHitTestVisible="False">
                                                <!-- Triggers / bumpers -->
                                                <Rectangle x:Name="PadL2Overlay" Canvas.Left="168" Canvas.Top="200" Width="110" Height="30" RadiusX="14" RadiusY="14" Style="{StaticResource PadOverlayStyle}"/>
                                                <Rectangle x:Name="PadR2Overlay" Canvas.Left="739" Canvas.Top="200" Width="110" Height="30" RadiusX="14" RadiusY="14" Style="{StaticResource PadOverlayStyle}"/>
                                                <Rectangle x:Name="PadL1Overlay" Canvas.Left="173" Canvas.Top="238" Width="100" Height="26" RadiusX="12" RadiusY="12" Style="{StaticResource PadOverlayStyle}"/>
                                                <Rectangle x:Name="PadR1Overlay" Canvas.Left="744" Canvas.Top="238" Width="100" Height="26" RadiusX="12" RadiusY="12" Style="{StaticResource PadOverlayStyle}"/>

                                                <!-- Touchpad zones -->
                                                <Rectangle x:Name="PadTouchLeftOverlay" Canvas.Left="402" Canvas.Top="268" Width="76" Height="150" RadiusX="10" RadiusY="10" Style="{StaticResource PadOverlayStyle}"/>
                                                <Rectangle x:Name="PadTouchCenterOverlay" Canvas.Left="482" Canvas.Top="268" Width="80" Height="150" RadiusX="10" RadiusY="10" Style="{StaticResource PadOverlayStyle}"/>
                                                <Rectangle x:Name="PadTouchRightOverlay" Canvas.Left="566" Canvas.Top="268" Width="76" Height="150" RadiusX="10" RadiusY="10" Style="{StaticResource PadOverlayStyle}"/>

                                                <!-- Create (Back) / Options -->
                                                <Ellipse x:Name="PadBackOverlay" Canvas.Left="362" Canvas.Top="329" Width="26" Height="26" Style="{StaticResource PadOverlayStyle}"/>
                                                <Ellipse x:Name="PadOptionsOverlay" Canvas.Left="653" Canvas.Top="329" Width="26" Height="26" Style="{StaticResource PadOverlayStyle}"/>

                                                <!-- D-Pad -->
                                                <Ellipse x:Name="PadUpOverlay" Canvas.Left="204" Canvas.Top="292" Width="36" Height="36" Style="{StaticResource PadOverlayStyle}"/>
                                                <Ellipse x:Name="PadLeftOverlay" Canvas.Left="160" Canvas.Top="348" Width="36" Height="36" Style="{StaticResource PadOverlayStyle}"/>
                                                <Ellipse x:Name="PadRightOverlay" Canvas.Left="246" Canvas.Top="348" Width="36" Height="36" Style="{StaticResource PadOverlayStyle}"/>
                                                <Ellipse x:Name="PadDownOverlay" Canvas.Left="204" Canvas.Top="404" Width="36" Height="36" Style="{StaticResource PadOverlayStyle}"/>

                                                <!-- Face buttons -->
                                                <Ellipse x:Name="PadTriangleOverlay" Canvas.Left="785" Canvas.Top="292" Width="36" Height="36" Style="{StaticResource PadOverlayStyle}"/>
                                                <Ellipse x:Name="PadSquareOverlay" Canvas.Left="729" Canvas.Top="348" Width="36" Height="36" Style="{StaticResource PadOverlayStyle}"/>
                                                <Ellipse x:Name="PadCircleOverlay" Canvas.Left="841" Canvas.Top="348" Width="36" Height="36" Style="{StaticResource PadOverlayStyle}"/>
                                                <Ellipse x:Name="PadCrossOverlay" Canvas.Left="785" Canvas.Top="404" Width="36" Height="36" Style="{StaticResource PadOverlayStyle}"/>

                                                <!-- PS Logo / Mute LED -->
                                                <Ellipse x:Name="PadPsOverlay" Canvas.Left="495" Canvas.Top="500" Width="28" Height="28" Style="{StaticResource PadOverlayStyle}"/>
                                                <Rectangle x:Name="PadMuteOverlay" Canvas.Left="499" Canvas.Top="538" Width="20" Height="8" RadiusX="3" RadiusY="3" Fill="#FF6600" Opacity="0"/>

                                                <!-- Stick wells + moving stick dots + L3/R3 rings -->
                                                <Ellipse Canvas.Left="360" Canvas.Top="456" Width="84" Height="84" Fill="#100099FF" Stroke="#300099FF" StrokeThickness="1"/>
                                                <Ellipse Canvas.Left="599" Canvas.Top="456" Width="84" Height="84" Fill="#100099FF" Stroke="#300099FF" StrokeThickness="1"/>
                                                <Ellipse x:Name="PadL3Overlay" Canvas.Left="360" Canvas.Top="456" Width="84" Height="84" Style="{StaticResource PadOverlayRingStyle}"/>
                                                <Ellipse x:Name="PadR3Overlay" Canvas.Left="599" Canvas.Top="456" Width="84" Height="84" Style="{StaticResource PadOverlayRingStyle}"/>
                                                <Ellipse x:Name="LeftStickDot" Canvas.Left="384" Canvas.Top="480" Width="36" Height="36" Fill="#990099FF" Stroke="#CCFFFFFF" StrokeThickness="1.5"/>
                                                <Ellipse x:Name="RightStickDot" Canvas.Left="623" Canvas.Top="480" Width="36" Height="36" Fill="#990099FF" Stroke="#CCFFFFFF" StrokeThickness="1.5"/>

                                                <!-- Touch finger dots -->
                                                <Ellipse x:Name="TouchDot0" Canvas.Left="0" Canvas.Top="0" Width="14" Height="14" Fill="#FFFFCC00" Stroke="#FFFFFFFF" StrokeThickness="1.5" Visibility="Hidden"/>
                                                <Ellipse x:Name="TouchDot1" Canvas.Left="0" Canvas.Top="0" Width="14" Height="14" Fill="#FFFFCC00" Stroke="#FFFFFFFF" StrokeThickness="1.5" Visibility="Hidden"/>
                                            </Canvas>
                                        </Grid>
                                    </Viewbox>
                                </Grid>

                                <!-- Bottom buttons (L3, Options, R3, Touchpad) -->
                                <Border Grid.Row="2" Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="2,0,2,0">
                                            <TextBlock Text="L3" FontSize="{DynamicResource TypeS}" Foreground="#0099FF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <Button x:Name="BtnMapL3" Tag="L3|l3" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="2,0,2,0">
                                            <TextBlock Text="{loc:Tr Key=ui.options}" FontSize="{DynamicResource TypeS}" Foreground="#0099FF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <Button x:Name="BtnMapOptions" Tag="Options|options" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Grid.Row="0" Margin="2,0,2,0">
                                            <TextBlock Text="R3" FontSize="{DynamicResource TypeS}" Foreground="#0099FF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <Button x:Name="BtnMapR3" Tag="R3|r3" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="2,5,2,0">
                                            <TextBlock Text="{loc:Tr Key=ui.touchpad_left}" FontSize="{DynamicResource TypeS}" Foreground="#FFA0A0A5" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <Button x:Name="BtnMapTouchpadLeft" Tag="TouchpadLeft|unmapped" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="2,5,2,0">
                                            <TextBlock Text="{loc:Tr Key=ui.touchpad_center}" FontSize="{DynamicResource TypeS}" Foreground="#FFA0A0A5" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <Button x:Name="BtnMapTouchpadCenter" Tag="TouchpadCenter|back" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Grid.Row="1" Margin="2,5,2,0">
                                            <TextBlock Text="{loc:Tr Key=ui.touchpad_right}" FontSize="{DynamicResource TypeS}" Foreground="#FFA0A0A5" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <Button x:Name="BtnMapTouchpadRight" Tag="TouchpadRight|unmapped" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Color Adjustment & Rumble Card -->
                                <Border Grid.Row="3" Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Tr Key=ui.color_adjustment_amp_haptics}" FontSize="{DynamicResource TypeS}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,4"/>
                                            
                                            <!-- RED -->
                                            <Grid Margin="0,1,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:Tr Key=ui.red}" FontSize="{DynamicResource TypeXS}" Foreground="White" VerticalAlignment="Center"/>
                                                <Slider x:Name="CtrlColorRSlider" Minimum="0" Maximum="255" Value="0" TickFrequency="16" IsSnapToTickEnabled="True" Grid.Column="1" VerticalAlignment="Center" ValueChanged="CtrlColorSliders_ValueChanged"/>
                                            </Grid>
                                            
                                            <!-- GREEN -->
                                            <Grid Margin="0,1,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:Tr Key=ui.green}" FontSize="{DynamicResource TypeXS}" Foreground="White" VerticalAlignment="Center"/>
                                                <Slider x:Name="CtrlColorGSlider" Minimum="0" Maximum="255" Value="0" TickFrequency="16" IsSnapToTickEnabled="True" Grid.Column="1" VerticalAlignment="Center" ValueChanged="CtrlColorSliders_ValueChanged"/>
                                            </Grid>
                                            
                                            <!-- BLUE -->
                                            <Grid Margin="0,1,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:Tr Key=ui.blue}" FontSize="{DynamicResource TypeXS}" Foreground="White" VerticalAlignment="Center"/>
                                                <Slider x:Name="CtrlColorBSlider" Minimum="0" Maximum="255" Value="255" TickFrequency="16" IsSnapToTickEnabled="True" Grid.Column="1" VerticalAlignment="Center" ValueChanged="CtrlColorSliders_ValueChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <CheckBox x:Name="CtrlOverrideColorCheck" Content="{loc:Tr Key=ui.override_color}" Foreground="White" FontSize="{DynamicResource TypeS}" IsChecked="True" Margin="0,0,0,6"/>
                                            <Border Background="Blue" MinHeight="24" BorderBrush="White" BorderThickness="1" CornerRadius="4" x:Name="CtrlColorBox"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Bottom actions -->
                                <Grid Grid.Row="4" Margin="0,5,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="RestoreDefaultMappingsBtn" Content="{loc:Tr Key=ui.restore_defaults}" Style="{StaticResource ModernButtonStyle}" MinWidth="110" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="0" Click="RestoreDefaultMappings_Click"/>
                                        <Button x:Name="TestRumbleBtn" Content="{loc:Tr Key=ui.vibration_test}" Style="{StaticResource ModernButtonStyle}" MinWidth="100" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="0" Margin="6,0,0,0" Click="TestRumbleBtn_Click" ToolTip="{loc:Tr Key=ui.sends_a_haptic_pulse_to_connected_dualsense_}"/>
                                        <Button x:Name="ToggleMicBtn" Content="{loc:Tr Key=ui.toggle_mic_led}" Style="{StaticResource ModernButtonStyle}" MinWidth="100" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="0" Margin="6,0,0,0" Click="ToggleMicBtn_Click" ToolTip="{loc:Tr Key=ui.toggles_controller_microphone_mute_led}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{loc:Tr Key=ui.save}" Style="{StaticResource ModernButtonStyle}" MinWidth="65" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="0" Click="SaveSettingsBtn_Click"/>
                                        <Button Content="{loc:Tr Key=ui.cancel}" Style="{StaticResource ModernButtonStyle}" MinWidth="65" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="0" Margin="6,0,0,0"/>
                                        <Button Content="{loc:Tr Key=ui.apply}" Style="{StaticResource ModernButtonStyle}" MinWidth="65" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="0" Margin="6,0,0,0" Click="SaveSettingsBtn_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- LIVE INPUT TESTER PANEL (in-app replacement for dualsense_visual.exe) -->
                                <Border x:Name="ControllerTesterPanel" Grid.Row="5" Visibility="Collapsed" Background="#15FFFFFF" BorderBrush="#200099FF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LEFT: digital + analog input readouts -->
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{loc:Tr Key=ui.live_input}" FontSize="{DynamicResource TypeS}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="TesterConnectionText" Text="{loc:Tr Key=ui.no_controller_connected}" FontSize="{DynamicResource TypeS}" Foreground="#FFA0A0A5" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TesterButtonsText" Text="{loc:Tr Key=ui.buttons}" FontSize="{DynamicResource TypeS}" Foreground="White" Margin="0,0,0,8" TextWrapping="Wrap" FontFamily="Consolas"/>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="L2" FontSize="{DynamicResource TypeS}" Foreground="White" VerticalAlignment="Center"/>
                                                <ProgressBar x:Name="TesterL2Bar" Grid.Column="1" Minimum="0" Maximum="255" Height="10" Background="#20FFFFFF" Foreground="#0099FF"/>
                                                <TextBlock x:Name="TesterL2Text" Grid.Column="2" Text="0" FontSize="{DynamicResource TypeS}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="R2" FontSize="{DynamicResource TypeS}" Foreground="White" VerticalAlignment="Center"/>
                                                <ProgressBar x:Name="TesterR2Bar" Grid.Column="1" Minimum="0" Maximum="255" Height="10" Background="#20FFFFFF" Foreground="#0099FF"/>
                                                <TextBlock x:Name="TesterR2Text" Grid.Column="2" Text="0" FontSize="{DynamicResource TypeS}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>
                                            </Grid>

                                            <TextBlock x:Name="TesterLeftStickText" Text="{loc:Tr Key=ui.left_stick_x_128_y_128}" FontSize="{DynamicResource TypeS}" Foreground="White" Margin="0,0,0,2" FontFamily="Consolas"/>
                                            <TextBlock x:Name="TesterRightStickText" Text="{loc:Tr Key=ui.right_stick_x_128_y_128}" FontSize="{DynamicResource TypeS}" Foreground="White" Margin="0,0,0,2" FontFamily="Consolas"/>
                                            <TextBlock x:Name="TesterTouchText" Text="{loc:Tr Key=ui.touchpad_released}" FontSize="{DynamicResource TypeS}" Foreground="White" Margin="0,0,0,2" FontFamily="Consolas"/>
                                            <TextBlock x:Name="TesterGyroText" Text="{loc:Tr Key=ui.gyro}" FontSize="{DynamicResource TypeS}" Foreground="White" Margin="0,0,0,2" FontFamily="Consolas"/>
                                            <TextBlock x:Name="TesterAccelText" Text="{loc:Tr Key=ui.accel}" FontSize="{DynamicResource TypeS}" Foreground="White" FontFamily="Consolas"/>
                                        </StackPanel>

                                        <!-- RIGHT: output tests (rumble, LEDs, lightbar, adaptive triggers) -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{loc:Tr Key=ui.output_tests}" FontSize="{DynamicResource TypeS}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,6"/>

                                            <TextBlock Text="{loc:Tr Key=ui.rumble}" FontSize="{DynamicResource TypeS}" Foreground="#FFA0A0A5" Margin="0,0,0,3"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Content="{loc:Tr Key=ui.low_freq}" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="6,0,6,0" Click="TesterRumbleLow_Click"/>
                                                <Button Content="{loc:Tr Key=ui.high_freq}" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="6,0,6,0" Margin="4,0,0,0" Click="TesterRumbleHigh_Click"/>
                                                <Button Content="{loc:Tr Key=ui.stop}" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="6,0,6,0" Margin="4,0,0,0" Click="TesterRumbleStop_Click"/>
                                            </StackPanel>

                                            <TextBlock Text="{loc:Tr Key=ui.lightbar_amp_player_leds}" FontSize="{DynamicResource TypeS}" Foreground="#FFA0A0A5" Margin="0,0,0,3"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Content="{loc:Tr Key=ui.set_lightbar_color}" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="6,0,6,0" Click="TesterLightbarApply_Click" ToolTip="{loc:Tr Key=ui.applies_the_red_green_blue_slider_values_to_}"/>
                                                <Button Content="{loc:Tr Key=ui.reset}" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="6,0,6,0" Margin="4,0,0,0" Click="TesterLightbarReset_Click"/>
                                                <Button Content="{loc:Tr Key=ui.cycle_player_led}" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="6,0,6,0" Margin="4,0,0,0" Click="TesterPlayerLed_Click"/>
                                            </StackPanel>

                                            <TextBlock Text="{loc:Tr Key=ui.adaptive_triggers_both_l2_r2}" FontSize="{DynamicResource TypeS}" Foreground="#FFA0A0A5" Margin="0,0,0,3"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Button Content="{loc:Tr Key=ui.off}" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="6,0,6,0" Click="TesterTriggerOff_Click"/>
                                                <Button Content="{loc:Tr Key=ui.feedback}" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="6,0,6,0" Margin="4,0,0,0" Click="TesterTriggerFeedback_Click"/>
                                                <Button Content="{loc:Tr Key=ui.weapon}" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="6,0,6,0" Margin="4,0,0,0" Click="TesterTriggerWeapon_Click"/>
                                                <Button Content="{loc:Tr Key=ui.vibration}" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="6,0,6,0" Margin="4,0,0,0" Click="TesterTriggerVibration_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="{loc:Tr Key=ui.speaker_amp_microphone_usb_only}" FontSize="{DynamicResource TypeS}" Foreground="#FFA0A0A5" Margin="0,0,0,3"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Button Content="{loc:Tr Key=ui.play_test_tone}" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="6,0,6,0" Click="TesterPlayTone_Click" ToolTip="{loc:Tr Key=ui.plays_a_440_hz_tone_through_the_dualsense_sp}"/>
                                                <Button x:Name="TesterMicTestBtn" Content="{loc:Tr Key=ui.mic_test}" Style="{StaticResource ModernButtonStyle}" MinHeight="22" FontSize="{DynamicResource TypeXS}" Padding="6,0,6,0" Margin="4,0,0,0" Click="TesterMicTest_Click" ToolTip="{loc:Tr Key=ui.live_level_meter_from_the_dualsense_micropho}"/>
                                                <ProgressBar x:Name="TesterMicLevelBar" Minimum="0" Maximum="100" Width="80" Height="10" Background="#20FFFFFF" Foreground="#0099FF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TesterStatusText" Text="" FontSize="{DynamicResource TypeXS}" Foreground="#FFCC66" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- COLUMN 2: RIGHT SIDE MAPPINGS -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="10,0,0,0">
                                    <!-- FACE BUTTONS CARD -->
                                    <Border Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Key=ui.face_buttons}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,8"/>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.triangle}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapTriangle" Tag="Triangle|triangle" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.circle}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapCircle" Tag="Circle|circle" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.cross}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapCross" Tag="Cross|cross" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.square}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapSquare" Tag="Square|square" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- R1 and R2 CARD -->
                                    <Border Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Key=ui.r1_and_r2}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,8"/>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="R1" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapR1" Tag="R1|r1" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="R2" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapR2" Tag="R2|r2" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- RIGHT STICK DEADZONE CARD -->
                                    <Border Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Key=ui.right_stick_deadzone}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,8"/>
                                            <TextBlock Text="{loc:Tr Key=ui.min_deadzone_def_2_max_127}" FontSize="{DynamicResource TypeS}" Foreground="#FFA0A0A5" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="CtrlMinDeadzoneRSlider" FocusVisualStyle="{StaticResource AccentFocusVisual}" Minimum="0" Maximum="127" Value="2" TickFrequency="5" IsSnapToTickEnabled="True" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ElementName=CtrlMinDeadzoneRSlider, Path=Value}" Foreground="White" FontWeight="Bold" FontSize="{DynamicResource TypeS}" HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="{loc:Tr Key=ui.max_deadzone_def_127_max_127}" FontSize="{DynamicResource TypeS}" Foreground="#FFA0A0A5" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="CtrlMaxDeadzoneRSlider" FocusVisualStyle="{StaticResource AccentFocusVisual}" Minimum="0" Maximum="127" Value="127" TickFrequency="5" IsSnapToTickEnabled="True" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ElementName=CtrlMaxDeadzoneRSlider, Path=Value}" Foreground="White" FontWeight="Bold" FontSize="{DynamicResource TypeS}" HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- RIGHT STICK CARD -->
                                    <Border Background="#15FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Key=ui.right_stick}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,8"/>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.up}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapRightStickUp" Tag="RightStickUp|axis_right_y" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.left}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapRightStickLeft" Tag="RightStickLeft|axis_right_x" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.right}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapRightStickRight" Tag="RightStickRight|axis_right_x" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,2">
                                                <TextBlock Text="{loc:Tr Key=ui.down}" Foreground="White" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}"/>
                                                <Button x:Name="BtnMapRightStickDown" Tag="RightStickDown|axis_right_y" Click="BtnMap_Click" Style="{StaticResource ModernButtonStyle}" MinWidth="120" MinHeight="22" FontSize="{DynamicResource TypeS}" Padding="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
                
                <!-- 2. SYSTEM SETTINGS VIEW (PLAYSTATION 5 MULTI-PAGE ARCHITECTURE) -->
                <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="40,10,40,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ========================================================================= -->
                    <!-- LEVEL 1: PS5 MAIN SETTINGS HUB (Categories Grid)                          -->
                    <!-- ========================================================================= -->
                    <Grid x:Name="SettingsHubView" Grid.Row="0" Grid.RowSpan="2" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Level 1 Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="{loc:Tr Key=ui.settings}" FontSize="{DynamicResource TypeDisplayS}" FontWeight="ExtraBold" Foreground="White"/>
                            <TextBlock Text="{loc:Tr Key=ui.customize_system_preferences_display_audio_c}" FontSize="{DynamicResource TypeL}" Foreground="#80A0A0A5" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Level 1 Category Grid -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <!-- Hub 1: Display & Video -->
                                <Button x:Name="HubBtn_Graphics" Tag="Graphics" Style="{StaticResource Ps5HubTileStyle}" Click="CategoryBtn_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#200099FF" CornerRadius="10" Width="40" MinHeight="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🖥️" FontSize="{DynamicResource Type4XL}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
