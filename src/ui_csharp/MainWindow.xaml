                                    <Grid Margin="0,0,0,16">
                                        <Border CornerRadius="6" Background="#15FFFFFF" MinHeight="10" VerticalAlignment="Center">
                                            <ProgressBar x:Name="BootProgressBar" Minimum="0" Maximum="100" Value="15" Background="Transparent" BorderThickness="0" Height="10" Foreground="#0099FF"/>
                                        </Border>
                                    </Grid>
                                    
                                    <TextBlock x:Name="BootProgressPercentText" Text="15%" FontSize="{DynamicResource TypeML}" FontWeight="Bold" Foreground="#0099FF" HorizontalAlignment="Right" Margin="0,-10,0,16"/>

