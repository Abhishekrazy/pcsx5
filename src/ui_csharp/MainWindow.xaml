<Window x:Class="Pcsx5Ui.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Pcsx5Ui"
        xmlns:local="clr-namespace:Pcsx5Ui"
 Title="PCSX5 - PlayStation 5 Emulator" Height="780" Width="1200"
 MinWidth="1050" MinHeight="680"
 WindowStartupLocation="CenterScreen"
 Background="{DynamicResource ThemeGround}"
 Foreground="{DynamicResource ThemeText}"
 FontFamily="Segoe UI Semibold, Inter, Outfit, Arial"
 Loaded="Window_Loaded"
 PreviewKeyDown="Window_PreviewKeyDown"
 Icon="pcsx5_icon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" 
 CornerRadius="{DynamicResource ThemeCornerM}" 
 CaptionHeight="64" 
 ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Windows 11 style global resources -->
        <SolidColorBrush x:Key="SystemAccentBrush" Color="#0099FF"/>
        <SolidColorBrush x:Key="AccentGlowBrush" Color="#3F0099FF"/>
        <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#CC0A0D14"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#3F000000"/>

        <!-- Controller input overlay styles: hidden until the matching button is pressed -->
        <Style x:Key="PadOverlayStyle" TargetType="Shape">
            <Setter Property="Fill" Value="#550099FF"/>
            <Setter Property="Stroke" Value="#0099FF"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style x:Key="PadOverlayRingStyle" TargetType="Shape">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="#0099FF"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        
        <!-- Navigation tab button style -->
        <Style x:Key="NavTabButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
            <Setter Property="FontSize" Value="{DynamicResource TypeL}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="20,0,20,0"/>
            <Setter Property="Margin" Value="5,0,5,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}" 
 Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeHairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8,15,8"/>
            <Setter Property="FontSize" Value="{DynamicResource TypeS}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}" 
 CornerRadius="{DynamicResource ThemeCornerS}"
 Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeTextMuted}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeHairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,5,15,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ThemeCornerS}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeHairline}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sub-tab: text label with an accent underline when active (Tag="active"). -->
        <Style x:Key="SubTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource TypeL}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Background="Transparent">
                            <ContentPresenter Margin="2,0,2,10"/>
                            <Border x:Name="U" Height="2" Background="{DynamicResource ThemeAccent}" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="active">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                <Setter TargetName="U" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mapping card: hairline card that rings accent when its bind button is focused. -->
        <Style x:Key="MapCardStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeHairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerM}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bind value: the current binding shown as a borderless mono line; still clickable/focusable. -->
        <Style x:Key="MapValueStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="FontFamily" Value="Consolas, monospace"/>
            <Setter Property="FontSize" Value="{DynamicResource TypeM}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings side-nav row: left-aligned; active row gets a soft accent fill (Tag="active"). -->
        <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
            <Setter Property="FontSize" Value="{DynamicResource TypeL}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="{DynamicResource ThemeCornerM}" Padding="18,14" Margin="0,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="active">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource ThemeRaised}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource ThemeRaised}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Controller Focus Style for ComboBox, Slider, CheckBox -->
        <!-- Dark themed dropdown items: readable text, accent hover/selected. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="{DynamicResource TypeM}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ThemeCornerS}" Margin="4,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeRaised}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark themed ComboBox: dark box + dark dropdown popup with a chevron. -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="{DynamicResource TypeM}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
 IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorderStrong}"
 BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerM}">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
 Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource ThemeTextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
 ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,30,0"
 VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{DynamicResource ThemeText}"/>
                            <Popup x:Name="Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
 IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Border Background="{DynamicResource ThemeRaised}" BorderBrush="{DynamicResource ThemeBorderStrong}"
 BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerM}" Margin="0,4,0,8"
 MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin dark scrollbar (replaces the chunky default). -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ThemeBorderStrong}" CornerRadius="4" Margin="3,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#3F0099FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="#0099FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- PS5 Console Theme Styles for Multi-Page Settings -->
        <Style x:Key="Ps5HubTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeHairline}"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder" Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}" 
 CornerRadius="{DynamicResource ThemeCornerL}" Padding="16,14">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ThemeRaised}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ps5SettingRowStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeHairline}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder" Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}" 
 CornerRadius="{DynamicResource ThemeCornerM}" Padding="18,12">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ThemeRaised}"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="RowBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ps5OptionItemStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeHairline}"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OptionBorder" Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}" 
 CornerRadius="{DynamicResource ThemeCornerM}" Padding="20,14">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="{DynamicResource ThemeRaised}"/>
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="OptionBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ps5PillToggleStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeHairline}"/>
            <Setter Property="Margin" Value="8,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" 
 BorderBrush="{TemplateBinding BorderBrush}" 
 BorderThickness="{TemplateBinding BorderThickness}" 
 CornerRadius="{DynamicResource ThemeCornerM}" Padding="24,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ThemeRaised}"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="PillBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings Card / Row Tile Style (Android TV Card Style) -->
        <Style x:Key="SettingsCardTileStyle" TargetType="Border">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <!-- Animated spinner keyframe -->
        <Style x:Key="SpinnerStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="#0099FF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The concept Library is a flat ground, not a blurred key-art backdrop
             (rebuild 2026-09-06). WindowBgImage is kept, collapsed, so the
             code that assigns its Source stays valid; nothing paints it. -->
        <Image x:Name="WindowBgImage" Stretch="UniformToFill" Visibility="Collapsed"/>

        <!-- Dark gradient overlay to fade the background art to black at the edges -->
        <Grid>
            <Grid.Background><SolidColorBrush Color="Transparent"/></Grid.Background>
        </Grid>

        <!-- Main Window Layout -->
        <Grid x:Name="MainLayoutRoot" Margin="0">
            <Grid.RowDefinitions>
                <!-- Title Bar & Navigation -->
                <RowDefinition Height="80"/>
                <!-- Content Area -->
                <RowDefinition Height="*"/>
                <!-- Status/Footer Bar -->
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Title Bar & Navigation Grid -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource ThemeGround}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="12" Height="12" CornerRadius="{DynamicResource ThemeCornerS}" Background="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="PCSX5" Foreground="{DynamicResource ThemeText}" FontSize="{DynamicResource Type2XL}" FontWeight="Bold" VerticalAlignment="Center"><TextBlock.LayoutTransform><ScaleTransform/></TextBlock.LayoutTransform></TextBlock>
                        <TextBlock Text="PS5" Foreground="{DynamicResource ThemeTextMuted}" FontSize="{DynamicResource TypeM}" Margin="8,4,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Navigation Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="TabLibraryBtn" Content="{loc:Tr Key=ui.game_library}" Style="{StaticResource NavTabButtonStyle}" Click="TabLibrary_Click"/>
                        <Button x:Name="TabAnalyzerBtn" Content="{loc:Tr Key=ui.boot_analyzer}" Style="{StaticResource NavTabButtonStyle}" Click="TabAnalyzer_Click"/>
                        <Button x:Name="TabControllerBtn" Content="{loc:Tr Key=ui.controller_setup}" Style="{StaticResource NavTabButtonStyle}" Click="TabController_Click"/>
                        <Button x:Name="TabSettingsBtn" Content="{loc:Tr Key=ui.system_settings}" Style="{StaticResource NavTabButtonStyle}" Click="TabSettings_Click"/>
                    </StackPanel>

                    <!-- Top-Right Controls & Search Box -->
                    <Grid Grid.Column="2" VerticalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <!-- Universal HUD: Performance metrics (FPS, RAM, Host CPU) -->
                            <StackPanel x:Name="HudMetricsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0" Visibility="Collapsed">
                                <TextBlock x:Name="HudFpsText" Text="FPS: --" FontSize="{DynamicResource TypeM}" Foreground="#50DD60" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="|" Foreground="#25FFFFFF" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HudRamText" Text="RAM: -- MB" FontSize="{DynamicResource TypeM}" Foreground="#FFA0A0A5" VerticalAlignment="Center"/>
                                <TextBlock Text="|" Foreground="#25FFFFFF" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HudVramText" Text="VRAM: -- MB" FontSize="{DynamicResource TypeM}" Foreground="#FFA0A0A5" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="BtnMinimize" Content="⚊" MinWidth="52" MinHeight="40" Background="Transparent" Foreground="{DynamicResource ThemeText}" BorderThickness="0" FontSize="{DynamicResource TypeL}" Click="Minimize_Click" Style="{x:Null}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnMaximize" Content="🗖" MinWidth="52" MinHeight="40" Background="Transparent" Foreground="{DynamicResource ThemeText}" BorderThickness="0" FontSize="{DynamicResource TypeM}" Click="Maximize_Click" Style="{x:Null}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnClose" Content="✕" MinWidth="52" MinHeight="40" Background="Transparent" Foreground="{DynamicResource ThemeText}" BorderThickness="0" FontSize="{DynamicResource TypeL}" Click="Close_Click" Style="{x:Null}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                    </Grid>
                </Grid>
            </Border>

            <!-- CONTENT VIEWS -->
            <Grid Grid.Row="1">
                
                <!-- 1. GAME LIBRARY VIEW (GRID) -->
                <Grid x:Name="LibraryView" Visibility="Visible" Margin="0">
                    <Grid.RowDefinitions>
                        <!-- Upper details area -->
                        <RowDefinition Height="*"/>
                        <!-- Lower carousel shelf -->
                        <RowDefinition Height="300"/>
                    </Grid.RowDefinitions>

                    <!-- Upper details area: details about selected game -->
                    <Grid x:Name="LibraryHero" Grid.Row="0" Margin="40,25,40,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/> <!-- Text Details -->
                            <ColumnDefinition Width="1*"/>   <!-- Mini Cover Display -->
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Big Game Title & Play Controls.
                             Bottom-anchored so the title and its action sit
                             directly above the tile row, as on the PS5 home
                             screen, rather than centred with dead space below. -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <!-- Rebuilt to the concept Main artboard 2026-09-06: CONTINUE
                                 eyebrow, a large title, a row of mono chips (id, size, a
                                 filled status badge, last played), then the accent Play
                                 with its glyph and a Game settings secondary. -->
                            <TextBlock x:Name="DetailEyebrow" Text="{loc:Tr Key=ui.continue_playing}" FontSize="{DynamicResource TypeS}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,14"/>
                            <TextBlock x:Name="DetailTitle" Text="{loc:Tr Key=ui.select_a_game}" FontSize="{DynamicResource TypeDisplayXL}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" LineHeight="62"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,22">
                                <Border Padding="12,5,12,5" CornerRadius="{DynamicResource ThemeCornerM}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock x:Name="DetailTitleId" Text="{loc:Tr Key=ui.no_game_selected}" FontSize="{DynamicResource TypeS}" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Padding="12,5,12,5" CornerRadius="{DynamicResource ThemeCornerM}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock x:Name="DetailSize" Text="-" FontSize="{DynamicResource TypeS}" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="DetailCompatBadge" Padding="12,5,12,5" CornerRadius="{DynamicResource ThemeCornerM}" Background="{DynamicResource ThemeRaised}" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock x:Name="DetailCompatText" Text="{loc:Tr Key=ui.unknown}" FontSize="{DynamicResource TypeS}" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                                </Border>
                                <Border x:Name="DetailLastPlayedChip" Padding="12,5,12,5" CornerRadius="{DynamicResource ThemeCornerM}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="DetailLastPlayed" Text="" FontSize="{DynamicResource TypeS}" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Kept for the developer path but not shown (the concept hero
                                 has no filesystem path); code-behind still sets it. -->
                            <TextBlock x:Name="DetailPath" Text="-" Visibility="Collapsed"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LaunchButton" MinWidth="150" MinHeight="56" Cursor="Hand" Click="LaunchButton_Click" AutomationProperties.Name="{loc:Tr Key=ui.play_game}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccent}"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="PlayRing" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ThemeCornerM}" Padding="28,0,28,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Width="15" Height="15" Margin="0,0,12,0" Stretch="Uniform" Fill="{DynamicResource ThemeOnAccent}" Data="M4 2.5v11l9-5.5z" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{loc:Tr Key=ui.play_game}" FontSize="{DynamicResource Type2XL}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="PlayRing" Property="Effect">
                                                                    <Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55"/></Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="PlayRing" Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="GameSettingsButton" Content="{loc:Tr Key=ui.game_settings}" MinHeight="56" Margin="14,0,0,0" Cursor="Hand" Click="TabSettings_Click" AutomationProperties.Name="{loc:Tr Key=ui.game_settings}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ThemeCornerM}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" Padding="24,0,24,0">
                                                            <TextBlock Text="{TemplateBinding Content}" FontSize="{DynamicResource TypeXL}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeRaised}"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="StopButton" Content="{loc:Tr Key=ui.stop}" MinWidth="100" MinHeight="56" FontSize="{DynamicResource TypeXL}" FontWeight="Bold" Margin="14,0,0,0" Cursor="Hand" Visibility="Collapsed" Click="StopButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource ThemeDanger}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccent}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ThemeCornerM}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Column: Visual Art Preview of Selected Game -->
                        <Border x:Name="GameCoverDisplayBorder" local:Theme.ClipCorners="16" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,0" Width="340" Height="340" CornerRadius="{DynamicResource ThemeCornerL}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" Background="{DynamicResource ThemeSurface}"><Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.5"/></Border.Effect><Border x:Name="GameCoverInner" Background="{DynamicResource ThemeRaised}"/></Border>
                    </Grid>

                    <!-- Lower Carousel shelf: horizontal scrolling game icons -->
                    <Grid x:Name="LibraryCarousel" Grid.Row="1" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="40,15,40,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LibraryHeaderTextBlock" Grid.Column="0" Text="{loc:Tr Key=ui.recent}" FontSize="{DynamicResource TypeS}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LibraryGameCount" Text="{loc:Tr Key=ui.0_games}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button x:Name="FullLibraryToggleBtn" Content="{loc:Tr Key=ui.view_all}" MinWidth="110" MinHeight="28" FontSize="{DynamicResource TypeS}" Style="{StaticResource ModernButtonStyle}" Click="ToggleFullLibrary_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="LibraryScroller" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Style="{StaticResource ModernScrollViewer}" Padding="35,0,10,0">
                                <StackPanel x:Name="GamesWrapPanel" Orientation="Horizontal" VerticalAlignment="Center" Height="320"/>
                            </ScrollViewer>

                            <!-- Scroll arrows -->
                            <Button x:Name="LibraryScrollLeft" Content="◀" MinWidth="52" MinHeight="52" HorizontalAlignment="Left" VerticalAlignment="Center"
 Background="{DynamicResource ThemeRaised}" Foreground="{DynamicResource ThemeText}" FontSize="{DynamicResource TypeL}" BorderThickness="0" Margin="8,0,0,0"
 Visibility="Collapsed" Click="LibraryScrollLeft_Click" Panel.ZIndex="10"/>
                            <Button x:Name="LibraryScrollRight" Content="▶" MinWidth="52" MinHeight="52" HorizontalAlignment="Right" VerticalAlignment="Center"
 Background="{DynamicResource ThemeRaised}" Foreground="{DynamicResource ThemeText}" FontSize="{DynamicResource TypeL}" BorderThickness="0" Margin="0,0,8,0"
 Visibility="Collapsed" Click="LibraryScrollRight_Click" Panel.ZIndex="10"/>
                        </Grid>

                        <!-- Spacer -->
                        <Border Grid.Row="2" MinHeight="10"/>
                    </Grid>

                    <!-- Full library grid view (hidden by default) -->
                    <!-- All games (TASKS 4.13 step 3): every colour a theme token. -->
                    <Grid x:Name="FullLibraryGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent" Margin="40,25,40,15">
                        <Grid.Resources>
                            <!-- One segment of the sort control. The active one is set
                                 from code (UpdateSortSegments) by Tag == _librarySort. -->
                            <Style x:Key="SortSegmentStyle" TargetType="Button">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeHairline}"/>
                                <Setter Property="Padding" Value="16,0,16,0"/>
                                <Setter Property="Height" Value="44"/>
                                <Setter Property="FontSize" Value="{DynamicResource TypeML}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="FullLibraryBackBtn" Content="{loc:Tr Key=ui.back_to_carousel}" MinWidth="140" MinHeight="44" FontSize="{DynamicResource TypeS}" Style="{StaticResource ModernButtonStyle}" Click="ToggleFullLibrary_Click" Margin="0,0,20,0"/>
                                <TextBlock Text="{loc:Tr Key=ui.all_games}" FontSize="{DynamicResource TypeDisplayS}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FullLibraryCount" Text="{loc:Tr Key=ui.0_games}" FontSize="{DynamicResource TypeS}" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="14,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Height="44" Width="260" CornerRadius="{DynamicResource ThemeCornerM}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" Background="{DynamicResource ThemeSurface}" Margin="0,0,12,0">
                                    <Grid>
                                        <TextBlock x:Name="LibrarySearchHint" Text="{loc:Tr Key=ui.search_hint}" FontSize="{DynamicResource TypeML}" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                                        <TextBox x:Name="LibrarySearchBox" AutomationProperties.Name="{loc:Tr Key=ui.search_hint}" FontSize="{DynamicResource TypeML}" Background="Transparent" Foreground="{DynamicResource ThemeText}" CaretBrush="{DynamicResource ThemeAccent}" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0,12,0" TextChanged="LibrarySearchBox_TextChanged"/>
                                    </Grid>
                                </Border>
                                <Border Height="44" CornerRadius="{DynamicResource ThemeCornerM}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SortRecentBtn" Tag="0" Content="{loc:Tr Key=ui.sort_recent}" AutomationProperties.Name="{loc:Tr Key=ui.sort_recent}" Click="LibrarySortSegment_Click" Style="{StaticResource SortSegmentStyle}"/>
                                        <Button x:Name="SortTitleBtn" Tag="1" Content="{loc:Tr Key=ui.sort_title}" AutomationProperties.Name="{loc:Tr Key=ui.sort_title}" Click="LibrarySortSegment_Click" Style="{StaticResource SortSegmentStyle}"/>
                                        <Button x:Name="SortTitleIdBtn" Tag="2" Content="{loc:Tr Key=ui.sort_title_id}" AutomationProperties.Name="{loc:Tr Key=ui.sort_title_id}" Click="LibrarySortSegment_Click" Style="{StaticResource SortSegmentStyle}"/>
                                        <Button x:Name="SortSizeBtn" Tag="3" Content="{loc:Tr Key=ui.sort_size_short}" AutomationProperties.Name="{loc:Tr Key=ui.sort_size_short}" Click="LibrarySortSegment_Click" Style="{StaticResource SortSegmentStyle}"/>
                                        <Button x:Name="SortFavBtn" Tag="4" Content="{loc:Tr Key=ui.sort_favourites}" AutomationProperties.Name="{loc:Tr Key=ui.sort_favourites}" Click="LibrarySortSegment_Click" Style="{StaticResource SortSegmentStyle}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <!-- "View All" shows the library as a grid of cover tiles
                             (asked 2026-09-06), not a table. It stays a ListView
                             under the same name so the pad navigation, the count
                             and the item source are unchanged; only the item
                             layout differs. Tiles are 180 px square with the
                             title over the bottom edge, matching the shelf. -->
                        <ListView x:Name="FullLibraryListView" FocusVisualStyle="{x:Null}" Grid.Row="1" Background="Transparent" Foreground="White" BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionMode="Single" SelectionChanged="FullLibraryListView_SelectionChanged" MouseDoubleClick="FullLibraryListView_MouseDoubleClick"
                                  AutomationProperties.Name="{loc:Tr Key=ui.view_all}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <!-- Design pass 2026-09-06, SharpEmu's launcher as the
                                         reference: the name sits under the cover instead of
                                         over it, the card carries a shadow, tiles not in
                                         focus are dimmed and the focused one lifts and
                                         gains a light ring. -->
                                    <StackPanel x:Name="TileRoot" Width="164" Opacity="0.72" RenderTransformOrigin="0.5,0.5">
                                        <StackPanel.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/>
                                                <TranslateTransform x:Name="TileLift" Y="0"/>
                                            </TransformGroup>
                                        </StackPanel.RenderTransform>
                                        <Border x:Name="Tile" local:Theme.ClipCorners="9" Width="160" Height="160" CornerRadius="{DynamicResource ThemeCornerM}" BorderThickness="2" BorderBrush="Transparent" Background="{DynamicResource ThemeSurface}" Margin="2,6,2,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="22" ShadowDepth="8" Direction="270" Opacity="0.45"/>
                                            </Border.Effect>
                                            <Border CornerRadius="{DynamicResource ThemeCornerS}" ClipToBounds="True" Background="{Binding PlaceholderBrush}">
                                                <Grid>
                                                    <!-- Initials stand in when a dump has no cover, so a tile is never a blank square. -->
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ThemeText}" FontSize="{DynamicResource TypeS}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="10"/>
                                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
                                                    <Path x:Name="FavStar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource ThemeAccent}" Data="M8 1.5l2 4.3 4.7.5-3.5 3.2 1 4.6L8 11.8 3.8 14.1l1-4.6L1.3 6.3 6 5.8z"/>
                                                </Grid>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ThemeText}" FontSize="{DynamicResource TypeS}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="2,8,2,0"/>
                                    </StackPanel>
                                    <DataTemplate.Resources>
                                        <!-- Motion (design pass 2026-09-06): the lift, scale and
                                             brightening ease over ~150 ms instead of snapping,
                                             the way the SharpEmu launcher's tiles move. -->
                                        <CubicEase x:Key="TileEase" EasingMode="EaseOut"/>
                                        <Storyboard x:Key="TileFocusIn">
                                            <DoubleAnimation Storyboard.TargetName="TileRoot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" EasingFunction="{StaticResource TileEase}"/>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.16" EasingFunction="{StaticResource TileEase}"/>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.16" EasingFunction="{StaticResource TileEase}"/>
                                            <DoubleAnimation Storyboard.TargetName="TileLift" Storyboard.TargetProperty="Y" To="-5" Duration="0:0:0.16" EasingFunction="{StaticResource TileEase}"/>
                                        </Storyboard>
                                        <Storyboard x:Key="TileFocusOut">
                                            <DoubleAnimation Storyboard.TargetName="TileRoot" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.11" EasingFunction="{StaticResource TileEase}"/>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" EasingFunction="{StaticResource TileEase}"/>
                                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" EasingFunction="{StaticResource TileEase}"/>
                                            <DoubleAnimation Storyboard.TargetName="TileLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.16" EasingFunction="{StaticResource TileEase}"/>
                                        </Storyboard>
                                    </DataTemplate.Resources>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                                            <Setter TargetName="FavStar" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource ThemeText}"/>
                                            <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource TileFocusIn}"/></DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><BeginStoryboard Storyboard="{StaticResource TileFocusOut}"/></DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                            <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource TileFocusIn}"/></DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><BeginStoryboard Storyboard="{StaticResource TileFocusOut}"/></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Margin" Value="0,4,14,14"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Grid>
                
                <!-- 1.4b. TOOLS HUB VIEW - rebuilt to the concept artboard 2026-09-06.
                     The Tools tab lands on a grid of tool cards; the Boot analyzer
                     card opens the analyzer sub-view below. Cards for tools not yet
                     built are shown disabled with a "Soon" tag rather than faked. -->
                <Grid x:Name="ToolsHubView" Visibility="Collapsed" Margin="56,28,56,20">
                    <Grid.Resources>
                        <Style x:Key="ToolCardStyle" TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Card" Height="170" Padding="24"
 Background="{DynamicResource ThemeRaised}" BorderBrush="{DynamicResource ThemeHairline}"
 BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerL}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Card" Property="Opacity" Value="0.5"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="ToolCardTitle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource TypeXL}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                        </Style>
                        <Style x:Key="ToolCardDesc" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource TypeM}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="0,10,0,0"/>
                            <Setter Property="LineHeight" Value="21"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ToolsHubTitle" Grid.Row="0" Text="{loc:Tr Key=sidebar.tools}"
 FontSize="{DynamicResource TypeDisplayL}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,22"/>

                    <ItemsControl Grid.Row="1" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- Boot analyzer - the one live tool -->
                        <Button x:Name="ToolCardBoot" Style="{StaticResource ToolCardStyle}" Margin="0,0,20,20" Click="ToolBootAnalyzer_Click">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="{loc:Tr Key=tools.card.boot.title}" Style="{StaticResource ToolCardTitle}"/>
                                <TextBlock Text="{loc:Tr Key=tools.card.boot.desc}" Style="{StaticResource ToolCardDesc}"/>
                            </StackPanel>
                        </Button>

                        <!-- Crash reports -->
                        <Button Style="{StaticResource ToolCardStyle}" Margin="0,0,20,20" IsEnabled="False" Focusable="False">
                            <Grid>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="{loc:Tr Key=tools.card.crash.title}" Style="{StaticResource ToolCardTitle}"/>
                                    <TextBlock Text="{loc:Tr Key=tools.card.crash.desc}" Style="{StaticResource ToolCardDesc}"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource ThemeAccentSoft}" CornerRadius="{DynamicResource ThemeCornerM}" Padding="10,3">
                                    <TextBlock Text="{loc:Tr Key=tools.soon}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Extract package -->
                        <Button Style="{StaticResource ToolCardStyle}" Margin="0,0,0,20" IsEnabled="False" Focusable="False">
                            <Grid>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="{loc:Tr Key=tools.card.pkg.title}" Style="{StaticResource ToolCardTitle}"/>
                                    <TextBlock Text="{loc:Tr Key=tools.card.pkg.desc}" Style="{StaticResource ToolCardDesc}"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource ThemeAccentSoft}" CornerRadius="{DynamicResource ThemeCornerM}" Padding="10,3">
                                    <TextBlock Text="{loc:Tr Key=tools.soon}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Shader cache -->
                        <Button Style="{StaticResource ToolCardStyle}" Margin="0,0,20,0" IsEnabled="False" Focusable="False">
                            <Grid>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="{loc:Tr Key=tools.card.shader.title}" Style="{StaticResource ToolCardTitle}"/>
                                    <TextBlock Text="{loc:Tr Key=tools.card.shader.desc}" Style="{StaticResource ToolCardDesc}"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource ThemeAccentSoft}" CornerRadius="{DynamicResource ThemeCornerM}" Padding="10,3">
                                    <TextBlock Text="{loc:Tr Key=tools.soon}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Input recorder -->
                        <Button Style="{StaticResource ToolCardStyle}" Margin="0,0,20,0" IsEnabled="False" Focusable="False">
                            <Grid>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="{loc:Tr Key=tools.card.recorder.title}" Style="{StaticResource ToolCardTitle}"/>
                                    <TextBlock Text="{loc:Tr Key=tools.card.recorder.desc}" Style="{StaticResource ToolCardDesc}"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource ThemeAccentSoft}" CornerRadius="{DynamicResource ThemeCornerM}" Padding="10,3">
                                    <TextBlock Text="{loc:Tr Key=tools.soon}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Memory map -->
                        <Button Style="{StaticResource ToolCardStyle}" Margin="0,0,0,0" IsEnabled="False" Focusable="False">
                            <Grid>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="{loc:Tr Key=tools.card.memory.title}" Style="{StaticResource ToolCardTitle}"/>
                                    <TextBlock Text="{loc:Tr Key=tools.card.memory.desc}" Style="{StaticResource ToolCardDesc}"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource ThemeAccentSoft}" CornerRadius="{DynamicResource ThemeCornerM}" Padding="10,3">
                                    <TextBlock Text="{loc:Tr Key=tools.soon}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/>
                                </Border>
                            </Grid>
                        </Button>
                    </ItemsControl>
                </Grid>
                <!-- 1.5. BOOT ANALYZER VIEW - rebuilt to the concept artboard
                     2026-09-06. Breadcrumb + actions header; a titles table with a
                     per-title "where the parse stops" result chip; and a report for
                     the selected title (facts, a boot-readiness checklist built from
                     the parser's own signals, and the raw parser log). The checklist
                     stages are only those the static parser actually evidences -
                     container, segments, decryption, alignment, module load - not
                     runtime stages (relocations/imports/first frame) it cannot know. -->
                <Grid x:Name="AnalyzerView" Visibility="Collapsed" Margin="56,28,56,20">
                    <Grid.Resources>
                        <local:AnalyzerStateBrushConverter x:Key="StateBrush"/>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header: breadcrumb + title + actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,22">
                        <StackPanel HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="AnalyzerBackBtn" Content="{loc:Tr Key=tools.back}" Style="{StaticResource SecondaryButtonStyle}"
 MinHeight="30" Padding="12,0" Click="AnalyzerBack_Click"/>
                                <TextBlock Text="/" FontFamily="Consolas" Foreground="{DynamicResource ThemeHairline}" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Key=tools.card.boot.title}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="AnalyzerHeaderTextBlock" Text="{loc:Tr Key=tools.card.boot.title}" FontSize="{DynamicResource TypeDisplayL}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                            <TextBlock Text="{loc:Tr Key=analyzer.subtitle}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Content="{loc:Tr Key=ui.export_minimal_summary}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Padding="18,0" Click="ExportSummary_Click"/>
                            <Button Content="{loc:Tr Key=analyzer.analyze}" Style="{StaticResource ModernButtonStyle}" MinHeight="44" Padding="20,0" Margin="12,0,0,0" Click="AnalyzeAll_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Body: titles table (left) + report (right) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Titles table -->
                        <Border Grid.Column="0" Background="{DynamicResource ThemeRaised}" BorderBrush="{DynamicResource ThemeHairline}"
 BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerL}" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- search -->
                                    <RowDefinition Height="Auto"/> <!-- column headers -->
                                    <RowDefinition Height="*"/>    <!-- list -->
                                </Grid.RowDefinitions>

                                <!-- search -->
                                <Border Grid.Row="0" Margin="16,14,16,10" Background="{DynamicResource ThemeSurface}"
 BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerM}" Padding="12,0">
                                    <Grid>
                                        <TextBox x:Name="AnalyzerSearchBox" MinHeight="38" BorderThickness="0" Background="Transparent"
 Foreground="{DynamicResource ThemeText}" CaretBrush="{DynamicResource ThemeText}" VerticalContentAlignment="Center"
 FontSize="{DynamicResource TypeM}" TextChanged="AnalyzerSearch_TextChanged"
 AutomationProperties.Name="{loc:Tr Key=analyzer.search}"/>
                                        <TextBlock x:Name="AnalyzerSearchPlaceholder" Text="{loc:Tr Key=analyzer.search}" IsHitTestVisible="False"
 Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" FontSize="{DynamicResource TypeM}" Margin="2,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- column headers -->
                                <Grid Grid.Row="1" Margin="22,4,22,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="AnalyzerSelectAll" Margin="0,0,14,0" VerticalAlignment="Center"
 Click="AnalyzerSelectAll_Click" ToolTip="{loc:Tr Key=analyzer.select_all}" AutomationProperties.Name="{loc:Tr Key=analyzer.select_all}"/>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Key=ui.game_title}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBlock Grid.Column="2" Text="{loc:Tr Key=ui.title_id}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBlock Grid.Column="3" Text="{loc:Tr Key=ui.format}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    <TextBlock Grid.Column="4" Text="{loc:Tr Key=analyzer.result}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/>
                                </Grid>
                                <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource ThemeHairline}"/>

                                <ListView x:Name="AnalyzerListView" Grid.Row="2" FocusVisualStyle="{StaticResource AccentFocusVisual}"
 Background="Transparent" Foreground="{DynamicResource ThemeText}" BorderThickness="0"
 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="AnalyzerListView_SelectionChanged">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent"
 BorderThickness="2" CornerRadius="{DynamicResource ThemeCornerM}" Padding="20,0" Margin="8,1">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="56">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"
 AutomationProperties.Name="{Binding Title}"/>
                                                <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="{DynamicResource ThemeCornerS}" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TitleId}" FontFamily="Consolas, monospace" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Format}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" Fill="{Binding ResultState, Converter={StaticResource StateBrush}}"/>
                                                    <TextBlock Text="{Binding ResultText}" FontSize="{DynamicResource TypeS}" Foreground="{Binding ResultState, Converter={StaticResource StateBrush}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Report for the selected title -->
                        <Grid Grid.Column="1" x:Name="AnalyzerReport">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- header + facts -->
                            <Border Grid.Row="0" Background="{DynamicResource ThemeRaised}" BorderBrush="{DynamicResource ThemeHairline}"
 BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerL}" Padding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <Border Width="52" Height="52" CornerRadius="{DynamicResource ThemeCornerM}" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" Margin="0,0,14,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource TypeXL}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                                            <TextBlock Text="{Binding HeaderMeta}" FontFamily="Consolas, monospace" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <UniformGrid Columns="2">
                                        <Border BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerM}" Padding="12,10" Margin="0,0,6,6">
                                            <StackPanel><TextBlock Text="{loc:Tr Key=ui.format}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/><TextBlock Text="{Binding Format}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        </Border>
                                        <Border BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerM}" Padding="12,10" Margin="6,0,0,6">
                                            <StackPanel><TextBlock Text="{loc:Tr Key=ui.encryption}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/><TextBlock Text="{Binding EncryptionStatus}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        </Border>
                                        <Border BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerM}" Padding="12,10" Margin="0,6,6,0">
                                            <StackPanel><TextBlock Text="{loc:Tr Key=ui.footprint}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/><TextBlock Text="{Binding MemoryFootprint}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeText}" Margin="0,4,0,0"/></StackPanel>
                                        </Border>
                                        <Border BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerM}" Padding="12,10" Margin="6,6,0,0">
                                            <StackPanel><TextBlock Text="{loc:Tr Key=ui.alignment}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/><TextBlock Text="{Binding AlignmentStatus}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- boot-readiness checklist -->
                            <Border Grid.Row="1" Background="{DynamicResource ThemeRaised}" BorderBrush="{DynamicResource ThemeHairline}"
 BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerL}" Padding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Key=analyzer.readiness}" FontSize="{DynamicResource TypeM}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding Stages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" Fill="{Binding State, Converter={StaticResource StateBrush}, ConverterParameter=soft}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontFamily="Consolas, monospace" FontSize="{DynamicResource TypeS}" Foreground="{Binding State, Converter={StaticResource StateBrush}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- parser log -->
                            <Border Grid.Row="2" Background="{DynamicResource ThemeGround}" BorderBrush="{DynamicResource ThemeHairline}"
 BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerL}" Padding="16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{loc:Tr Key=analyzer.parser_log}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,8"/>
                                    <TextBox x:Name="AnalyzerOutputTextBox" Grid.Row="1" Background="Transparent" Foreground="{DynamicResource ThemeTextMuted}" FontFamily="Consolas, Courier New" FontSize="11.5"
 BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" AcceptsReturn="True"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 1.7. CONTROLLER SETUP VIEW (GRID) -->
                <Grid x:Name="ControllerView" Visibility="Collapsed" Margin="40,10,40,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- title -->
                        <RowDefinition Height="Auto"/>  <!-- sub-tab bar -->
                        <RowDefinition Height="*"/>     <!-- Testing / Configuration (one shown at a time) -->
                        <RowDefinition Height="Auto"/>  <!-- unused -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Tr Key=ui.controller_setup_2}" FontSize="{DynamicResource TypeDisplayL}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,14"/>

                    <!-- The Input tab is the Configuration editor; live testing is a popup
                         opened only from this button (user request 2026-09-06). -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="TestControllerBtn" Content="{loc:Tr Key=input.test_controller}" Style="{StaticResource ModernButtonStyle}"
 MinHeight="40" Padding="20,0" Click="SubTabTest_Click" AutomationProperties.Name="{loc:Tr Key=input.test_controller}"/>
                        <Button x:Name="ControllerSettingsBtn" Content="{loc:Tr Key=input.controller_settings}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Padding="20,8" FontSize="{DynamicResource TypeS}" Margin="10,0,0,0" Click="ControllerSettings_Click" AutomationProperties.Name="{loc:Tr Key=input.controller_settings}"/>
                    </StackPanel>

                    <!-- Live controller view (TESTING): device info, real-time input, motion,
                         tests. Reads the pad through CoreBridge; drawn from
                         assets/gamepad/dualsense. All logic lives in InputTabView (Rule 11). -->
                    <!-- The live Testing view is a popup (InputTestOverlay) so the pad can be
                         tested without L1/R1/L2/R2 changing tabs; see SetInputSubTab. -->

                    <!-- Mapping editor (CONFIGURATION) -->
                    <Border x:Name="InputConfigView" Grid.Row="2" Background="{DynamicResource ThemeRaised}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerL}" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><DockPanel LastChildFill="True">

                            <!-- TUNING SIDEBAR (deadzones, profile, lightbar, actions) -->
                            <!-- BINDINGS GRID -->
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="{loc:Tr Key=input.map.header}" FontSize="{DynamicResource TypeML}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{loc:Tr Key=input.map.hint}" FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <UniformGrid Columns="6">
                                                <Border Style="{StaticResource MapCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Tr Key=input.map.cross}" FontSize="{DynamicResource TypeXS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                                                        <Button x:Name="BtnMapCross" Tag="Cross|cross" Click="BtnMap_Click" Style="{StaticResource MapValueStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MapCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Tr Key=input.map.circle}" FontSize="{DynamicResource TypeXS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                                                        <Button x:Name="BtnMapCircle" Tag="Circle|circle" Click="BtnMap_Click" Style="{StaticResource MapValueStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MapCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Tr Key=input.map.square}" FontSize="{DynamicResource TypeXS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                                                        <Button x:Name="BtnMapSquare" Tag="Square|square" Click="BtnMap_Click" Style="{StaticResource MapValueStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MapCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Tr Key=input.map.triangle}" FontSize="{DynamicResource TypeXS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                                                        <Button x:Name="BtnMapTriangle" Tag="Triangle|triangle" Click="BtnMap_Click" Style="{StaticResource MapValueStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MapCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Tr Key=input.map.l1}" FontSize="{DynamicResource TypeXS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                                                        <Button x:Name="BtnMapL1" Tag="L1|l1" Click="BtnMap_Click" Style="{StaticResource MapValueStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MapCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Tr Key=input.map.r1}" FontSize="{DynamicResource TypeXS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                                                        <Button x:Name="BtnMapR1" Tag="R1|r1" Click="BtnMap_Click" Style="{StaticResource MapValueStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MapCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Tr Key=input.map.l2}" FontSize="{DynamicResource TypeXS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                                                        <Button x:Name="BtnMapL2" Tag="L2|l2" Click="BtnMap_Click" Style="{StaticResource MapValueStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MapCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Tr Key=input.map.r2}" FontSize="{DynamicResource TypeXS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                                                        <Button x:Name="BtnMapR2" Tag="R2|r2" Click="BtnMap_Click" Style="{StaticResource MapValueStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MapCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Tr Key=input.map.dpad_up}" FontSize="{DynamicResource TypeXS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                                                        <Button x:Name="BtnMapUp" Tag="PadUp|pad_up" Click="BtnMap_Click" Style="{StaticResource MapValueStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MapCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Tr Key=input.map.dpad_down}" FontSize="{DynamicResource TypeXS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,6"/>
                                                        <Button x:Name="BtnMapDown" Tag="PadDown|pad_down" Click="BtnMap_Click" Style="{StaticResource MapValueStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource MapCardStyle}">
                                                    <StackPanel>
