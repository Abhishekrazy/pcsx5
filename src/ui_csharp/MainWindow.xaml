                            <Border Background="#121622" BorderBrush="#350070D1" BorderThickness="1.5" CornerRadius="18" Padding="32,28" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0070D1" BlurRadius="50" Opacity="0.5" ShadowDepth="0"/>
                                </Border.Effect>
                                <StackPanel HorizontalAlignment="Stretch">
                                    <!-- PS5 Pulse Icon -->
                                    <Border Background="#1F0070D1" BorderBrush="#500099FF" BorderThickness="1.5" CornerRadius="40" Width="72" MinHeight="72" HorizontalAlignment="Center" Margin="0,0,0,18">
                                        <TextBlock x:Name="BootSpinnerText" Text="💠" FontSize="{DynamicResource TypeDisplayM}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Step indicator badge -->
                                    <Border Background="#1E0099FF" CornerRadius="10" Padding="12,3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock x:Name="BootStepBadge" Text="{loc:Tr Key=ui.step_1_of_6}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF"/>
                                    </Border>

                                    <!-- Phase title -->
                                    <TextBlock x:Name="BootPhaseTitle" Text="{loc:Tr Key=ui.initializing_emulator_core}" FontSize="{DynamicResource Type3XL}" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6" TextAlignment="Center"/>

                                    <!-- Phase detail -->
                                    <TextBlock x:Name="BootPhaseDetail" Text="{loc:Tr Key=ui.allocating_128gb_virtual_memory_space}" FontSize="{DynamicResource TypeML}" Foreground="#8FA0A0A5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

