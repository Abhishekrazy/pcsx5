                                        <Button Content="{loc:Tr Key=ui.copy}" MinWidth="60" MinHeight="28" FontSize="{DynamicResource TypeS}" Padding="6,0" Style="{StaticResource ModernButtonStyle}" Click="CopyConsole_Click"/>
                                        <Button Content="{loc:Tr Key=ui.clear}" MinWidth="60" MinHeight="28" FontSize="{DynamicResource TypeS}" Padding="6,0" Margin="6,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="ClearConsole_Click"/>
