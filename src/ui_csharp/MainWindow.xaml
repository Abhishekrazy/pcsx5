                                            <TextBlock Text="⌨" FontSize="{DynamicResource TypeL}" Foreground="#FFA0A0A5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="{loc:Tr Key=ui.console_logs}" FontSize="{DynamicResource TypeL}" VerticalAlignment="Center"/>
                                            <TextBlock Text="  [△]" FontSize="{DynamicResource TypeM}" Foreground="#4DFFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

