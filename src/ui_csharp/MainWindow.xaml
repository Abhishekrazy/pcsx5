                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter Property="Background" Value="#30FF2200"/>
                                                        <Setter Property="BorderBrush" Value="#FF2200"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#25FF2200"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⏹" FontSize="{DynamicResource TypeL}" Foreground="#FF6644" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="{loc:Tr Key=ui.stop_game}" FontSize="{DynamicResource TypeL}" VerticalAlignment="Center"/>
                                            <TextBlock Text="  [◯]" FontSize="{DynamicResource TypeM}" Foreground="#4DFFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{loc:Tr Key=ui.d_pad_navigate}" FontSize="{DynamicResource TypeS}" Foreground="#30FFFFFF"
 HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Bottom game bar removed in favor of global Footer actions -->
                </Grid>

            </Grid>

            <!-- FOOTER STATUS BAR -->
            <Border Grid.Row="2" Background="#A0050508" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                        <TextBlock x:Name="FooterGamesCount" Text="{loc:Tr Key=ui.games_loaded_0}" FontSize="{DynamicResource TypeM}" Foreground="#6FA0A0A5"/>
                        <TextBlock Text="|" Foreground="#25FFFFFF" Margin="12,0,12,0"/>
                        <TextBlock x:Name="FooterStatus" Text="{loc:Tr Key=ui.ready}" FontSize="{DynamicResource TypeM}" Foreground="#0099FF"/>
                        <TextBlock Text="|" Foreground="#25FFFFFF" Margin="12,0,12,0"/>
                        <TextBlock x:Name="FooterGamepadHints" Text="{loc:Tr Key=ui.l1_r1_tabs_d_pad_move_select_back_settings}" FontSize="{DynamicResource TypeM}" FontWeight="SemiBold" Foreground="#0099FF"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Button x:Name="GameConsoleButton" Content="{loc:Tr Key=ui.console_2}" MinHeight="26" MinWidth="80" Padding="10,0"
 FontSize="{DynamicResource TypeS}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"
 Click="FooterConsole_Click" ToolTip="{loc:Tr Key=ui.toggle_console_log_viewer}"/>
                        <Button x:Name="GameStopButton" Content="{loc:Tr Key=ui.stop_2}" MinHeight="26" MinWidth="65" Padding="10,0"
 FontSize="{DynamicResource TypeS}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"
 Click="StopButton_Click" ToolTip="{loc:Tr Key=ui.request_graceful_stop}" Visibility="Collapsed"/>
                        <Button x:Name="GameKillButton" Content="{loc:Tr Key=ui.force_kill}" MinHeight="26" MinWidth="85" Padding="10,0"
 Background="#CC2200" BorderBrush="#FF4400" Foreground="White" FontWeight="Bold"
 FontSize="{DynamicResource TypeS}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"
 Click="KillButton_Click" ToolTip="{loc:Tr Key=ui.force_terminate_process}" Visibility="Collapsed"/>
                        <TextBlock Text="{loc:Tr Key=ui.pcsx5_playstation_5_emulator_v1_00}" FontSize="{DynamicResource TypeS}" Foreground="#3FA0A0A5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WATCHDOG TOAST — non-blocking "Game may be hung" warning -->
            <Border x:Name="WatchdogToast" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
 Background="#CC1A0D00" BorderBrush="#60FF6600" BorderThickness="1" CornerRadius="10"
 Padding="20,12" Margin="0,0,0,80" Visibility="Collapsed" Opacity="0"
 IsHitTestVisible="True">
                <Border.Effect>
                    <DropShadowEffect Color="#FF6600" BlurRadius="20" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" Foreground="#FF8800" FontSize="{DynamicResource TypeL}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{loc:Tr Key=ui.game_may_be_unresponsive}" Foreground="#E0FFFFFF" FontSize="{DynamicResource TypeML}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="WatchdogWaitBtn" Content="{loc:Tr Key=ui.wait}" MinWidth="70" MinHeight="28" Style="{StaticResource ModernButtonStyle}"
 FontSize="{DynamicResource TypeM}" Margin="0,0,6,0" Click="WatchdogWait_Click" Focusable="True"/>
                    <Button x:Name="WatchdogForceStopBtn" Content="{loc:Tr Key=ui.force_stop}" MinWidth="90" MinHeight="28"
 Background="#CC2200" BorderBrush="#FF2200" Foreground="White" FontSize="{DynamicResource TypeM}" FontWeight="Bold"
 Focusable="True" Click="WatchdogForceStop_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="{loc:Tr Key=ui.wait_stop}" FontSize="{DynamicResource TypeS}" Foreground="#4DFFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- TOAST NOTIFICATION OVERLAY -->
            <Border x:Name="ToastNotification" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
 Background="#CC1A1D24" BorderBrush="#3300FF99" BorderThickness="1" CornerRadius="10"
 Padding="18,10" Margin="0,0,0,50" Visibility="Collapsed" Opacity="0"
 IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#00FF99" BlurRadius="20" Opacity="0.35" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Text="✓" Foreground="#00FF99" FontSize="{DynamicResource TypeL}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ToastMessage" Text="{loc:Tr Key=ui.configuration_saved_successfully}" Foreground="#E0FFFFFF" FontSize="{DynamicResource TypeML}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>


            <!-- CRASH DIAGNOSTICS OVERLAY DIALOG -->
            <Grid x:Name="CrashDialogOverlay" Visibility="Collapsed" Background="#D905060A" Grid.RowSpan="3">
                <Border Background="#1C1F26" BorderBrush="#CC2200" BorderThickness="1.5" CornerRadius="12" MinWidth="580" MaxWidth="680" MinHeight="420" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF2200" BlurRadius="25" Opacity="0.4" ShadowDepth="0"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <Border Width="36" MinHeight="36" Background="#20FF2200" CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="⚠" Foreground="#FF3300" FontSize="{DynamicResource Type4XL}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Key=ui.crash_diagnostics}" FontSize="{DynamicResource Type2XL}" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{loc:Tr Key=ui.guest_application_exception_detected}" FontSize="{DynamicResource TypeM}" Foreground="#FFA0A0A5"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Details Area -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                            <StackPanel>
                                <!-- Summary Row -->
                                <Border Background="#26000000" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Key=ui.exception_code}" Foreground="#FFA0A0A5" FontWeight="SemiBold" FontSize="{DynamicResource TypeML}" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="CrashExcCodeText" Grid.Row="0" Grid.Column="1" Text="{loc:Tr Key=ui.0xc0000005_access_violation}" Foreground="White" FontWeight="Bold" FontSize="{DynamicResource TypeML}" Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Key=ui.address_rip}" Foreground="#FFA0A0A5" FontWeight="SemiBold" FontSize="{DynamicResource TypeML}"/>
                                        <TextBlock x:Name="CrashRipText" Grid.Row="1" Grid.Column="1" Text="0x800000080" Foreground="#0099FF" FontWeight="Bold" FontSize="{DynamicResource TypeML}"/>
                                    </Grid>
                                </Border>

                                <!-- Analysis -->
                                <TextBlock Text="{loc:Tr Key=ui.automated_analysis}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,6"/>
                                <Border Background="#100099FF" BorderBrush="#200099FF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                                    <TextBlock x:Name="CrashAnalysisText" TextWrapping="Wrap" Foreground="#FFD0D0D5" FontSize="{DynamicResource TypeML}" LineHeight="18"
 Text="{loc:Tr Key=ui.the_guest_application_crashed_at_address_0x8}"/>
                                </Border>

                                <!-- Raw Logs -->
                                <TextBlock Text="{loc:Tr Key=ui.crash_dump_extract}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#FFA0A0A5" Margin="0,0,0,6"/>
                                <TextBox x:Name="CrashRawText" IsReadOnly="True" Background="#15000000" Foreground="#FFA0A0A5" BorderThickness="0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="{DynamicResource TypeS}" Padding="8" MinHeight="80" MaxHeight="220" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Buttons -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Tr Key=ui.copy}" MinWidth="70" MinHeight="32" Padding="12,0" Style="{StaticResource SecondaryButtonStyle}" Click="CopyCrashToClipboard_Click" Margin="0,0,6,0"/>
                            <Button Content="{loc:Tr Key=ui.raw_logs}" MinWidth="80" MinHeight="32" Padding="12,0" Style="{StaticResource SecondaryButtonStyle}" Click="ViewCrashRawLogs_Click" Margin="0,0,6,0"/>
                            <Button Content="{loc:Tr Key=ui.dismiss}" MinWidth="70" MinHeight="32" Padding="12,0" Style="{StaticResource SecondaryButtonStyle}" Click="DismissCrashDialog_Click" Margin="0,0,6,0"/>
                            <Button Content="{loc:Tr Key=ui.boot_analyzer_2}" MinWidth="110" MinHeight="32" Padding="14,0" Style="{StaticResource ModernButtonStyle}" Click="AnalyzeCrashedGame_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- FIRST-RUN SETUP OVERLAY DIALOG (games folder picker) -->
            <Grid x:Name="FirstRunOverlay" Visibility="Collapsed" Background="#D905060A" Grid.RowSpan="3">
                <Border Background="#1C1F26" BorderBrush="#0099FF" BorderThickness="1.5" CornerRadius="12" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                    <Border.Effect>
                        <DropShadowEffect Color="#0099FF" BlurRadius="25" Opacity="0.35" ShadowDepth="0"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=ui.welcome_to_pcsx5}" FontSize="{DynamicResource Type5XL}" FontWeight="ExtraBold" Foreground="White" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#FFA0A0A5" FontSize="{DynamicResource TypeL}" LineHeight="20" Margin="0,0,0,18"
 Text="{loc:Tr Key=ui.before_you_start_choose_the_folder_where_you}"/>

                        <TextBlock Text="{loc:Tr Key=ui.games_folder}" FontSize="{DynamicResource TypeM}" FontWeight="Bold" Foreground="#0099FF" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#20FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <TextBlock x:Name="FirstRunFolderText" Text="{loc:Tr Key=ui.no_folder_selected}" Foreground="White" FontSize="{DynamicResource TypeML}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Button Grid.Column="1" Content="{loc:Tr Key=ui.browse}" MinWidth="100" MinHeight="32" Margin="10,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="FirstRunBrowse_Click"/>
                        </Grid>

                        <!-- Controller hint -->
                        <TextBlock Text="{loc:Tr Key=ui.browse_folder_skip_continue}" FontSize="{DynamicResource TypeM}" Foreground="#4D0099FF"
 HorizontalAlignment="Center" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="FirstRunSkipBtn" Content="{loc:Tr Key=ui.skip_for_now}" MinWidth="120" MinHeight="34" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="FirstRunSkip_Click" Focusable="True"/>
                            <Button x:Name="FirstRunContinueBtn" Content="{loc:Tr Key=ui.continue}" MinWidth="140" MinHeight="34" Style="{StaticResource ModernButtonStyle}" IsEnabled="False" Click="FirstRunContinue_Click" Focusable="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CONTROLLER FOLDER PICKER OVERLAY
                 Shows before opening the system folder browser dialog. -->

            <!-- In-app directory browser.  A Windows folder dialog cannot be
                 driven by a controller at all, so the shell browses the
                 filesystem itself.  All text is assigned from I18n at runtime,
                 which is why Content/Text are empty here. -->
            <Grid x:Name="FolderPickerOverlay" Visibility="Collapsed" Background="#D905060A" Grid.RowSpan="3">
                <Border Background="{DynamicResource PickerSurfaceBrush}"
 BorderBrush="{DynamicResource PickerAccentBrush}" BorderThickness="1.5" CornerRadius="12"
 Width="780" MinHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                    <Border.Effect>
                        <DropShadowEffect Color="#0099FF" BlurRadius="25" Opacity="0.35" ShadowDepth="0"/>
                    </Border.Effect>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock x:Name="FolderPickerTitle" FontSize="{DynamicResource Type2XL}" FontWeight="Bold"
 Foreground="{DynamicResource PickerTextBrush}"/>
                            <TextBlock x:Name="FolderPickerCurrentPath" FontSize="{DynamicResource TypeML}" Margin="0,6,0,0"
 Foreground="{DynamicResource PickerAccentBrush}"
 TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock x:Name="FolderPickerHints" DockPanel.Dock="Bottom" FontSize="{DynamicResource TypeM}"
 Foreground="{DynamicResource PickerMutedBrush}" Margin="0,14,0,0"/>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
 HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="FolderPickerUpBtn" MinWidth="110" MinHeight="36" Margin="0,0,10,0"
 Style="{StaticResource SecondaryButtonStyle}"
 Click="FolderPickerUp_Click" Focusable="True"/>
                            <Button x:Name="FolderPickerOpenBtn" MinWidth="110" MinHeight="36" Margin="0,0,10,0"
 Style="{StaticResource SecondaryButtonStyle}"
 Click="FolderPickerOpen_Click" Focusable="True"/>
                            <Button x:Name="FolderPickerSelectBtn" MinWidth="190" MinHeight="36" Margin="0,0,10,0"
 Style="{StaticResource ModernButtonStyle}"
 Click="FolderPickerSelect_Click" Focusable="True"/>
                            <Button x:Name="FolderPickerCancelBtn" MinWidth="110" MinHeight="36"
 Style="{StaticResource SecondaryButtonStyle}"
 Click="FolderPickerCancel_Click" Focusable="True"/>
                        </StackPanel>

                        <ListBox x:Name="FolderPickerList" FocusVisualStyle="{StaticResource AccentFocusVisual}"
 Background="{DynamicResource PickerListBrush}"
 BorderBrush="{DynamicResource PickerBorderBrush}" BorderThickness="1"
 Foreground="{DynamicResource PickerTextBrush}" FontSize="{DynamicResource TypeL}"
 MouseDoubleClick="FolderPickerList_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="6,7">
                                        <TextBlock Text="{Binding Icon}" FontSize="{DynamicResource TypeL}" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
 TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
