                                        <Button x:Name="ConsoleDockRightBtn" MinWidth="65" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="4,0" Margin="4,0,0,0" ToolTip="{loc:Tr Key=ui.dock_right}"
 Click="ConsoleDockMode_Click" Tag="Right" Style="{StaticResource ModernButtonStyle}">➡ Right</Button>
                                        <Button x:Name="ConsoleDockLeftBtn" MinWidth="60" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="4,0" Margin="4,0,0,0" ToolTip="{loc:Tr Key=ui.dock_left}"
 Click="ConsoleDockMode_Click" Tag="Left" Style="{StaticResource ModernButtonStyle}">⬅ Left</Button>
                                        <Button x:Name="ConsoleDockFloatBtn" MinWidth="62" MinHeight="26" FontSize="{DynamicResource TypeS}" Padding="4,0" Margin="4,0,0,0" ToolTip="{loc:Tr Key=ui.undock}"
 Click="ConsoleDockMode_Click" Tag="Float" Style="{StaticResource ModernButtonStyle}">↗ Float</Button>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="GameConsoleSlot" Grid.Row="1" Margin="6,0,6,6">
