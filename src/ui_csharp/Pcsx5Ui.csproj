<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- CoreBridge mirrors fixed-size C arrays (firmware build date/time)
         with `fixed` buffers, which require unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>   <!-- Helix Viewport3DX hosts its D3D surface via WindowsFormsIntegration -->
    <AssemblyName>pcsx5</AssemblyName>
    <ApplicationTitle>PCSX5 PlayStation 5 Emulator</ApplicationTitle>
    <ApplicationIcon>pcsx5_icon.ico</ApplicationIcon>
    <!-- Release version. The build passes -p:Version=<x.y.z> (ultimately from
         the VERSION file, or from the git tag in CI); this default only applies
         to an ad-hoc local build. Without it every build reported 1.0.0.0, so
         the Squirrel updater could never tell two releases apart. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <!-- Single-file self-contained publish: `dotnet build` still produces a
         normal framework-dependent layout for dev; `dotnet publish` produces
         the shippable single pcsx5.exe. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>   <!-- ~halves the self-contained exe; the runtime decompresses once at start -->
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="ps5_controller.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="pcsx5_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The VERSION file, shown read-only on the System Information page.
         Two levels up is the repository root. -->
    <Content Include="$(MSBuildProjectDirectory)/../../VERSION" Link="VERSION">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(MSBuildProjectDirectory)/../../README.md" Link="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- WASAPI access for the DualSense USB Audio Class endpoints
         (Controller Setup speaker/mic testers). -->
    <PackageReference Include="Clowd.Squirrel" Version="2.11.1" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <!-- 3D DualSense renderer (Input tab testing view): Direct3D 11 with real
         PBR shaders (base colour, normal, roughness/metallic maps), which WPF's
         own Viewport3D cannot do. MIT. Owner: shell. Update: bump the pin, run
         the Input popup capture. -->
    <PackageReference Include="HelixToolkit.SharpDX.Core.Wpf" Version="2.27.3" />
  </ItemGroup>

  <!-- Localization files.  I18n.Load looks for assets/lang next to the app and
       then walks up only five directory levels; the build output sits six levels
       below the repository root, so without this copy the app finds nothing and
       renders raw translation keys.  Copying them makes the app self-contained
       instead of depending on where it happens to sit. -->
  <ItemGroup>
    <!-- 3D DualSense for the Input tab's Testing view: one OBJ per animatable
         part plus textures and manifest, split from a CC-BY-4.0 Sketchfab model;
         credit in that folder's README. Rendered with WPF's own Viewport3D. -->
    <Content Include="$(MSBuildProjectDirectory)/../../assets/gamepad/dualsense3d/**/*.*"
             Link="assets/gamepad/dualsense3d/%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(MSBuildProjectDirectory)/../../assets/lang/*.json"
             Link="assets/lang/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Boot analyzer used by the Tools tab.  LocateBootParser() probes a fixed
       list of relative paths; the dev tree happens to match one but the packaged
       layout does not, so carry the tool with the app instead of guessing. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/../../build/Release/pcsx5_boot_parser.exe')">
    <Content Include="$(MSBuildProjectDirectory)/../../build/Release/pcsx5_boot_parser.exe"
             Link="pcsx5_boot_parser.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Emulator core built by CMake (build/bin/pcsx5_core.dll).  Copied next
       to the app in both build and publish output so DllImport("pcsx5_core")
       resolves at runtime.  Conditional so a missing native build does not
       break a pure-C# compile. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/../../build/bin/pcsx5_core.dll')">
    <Content Include="$(MSBuildProjectDirectory)/../../build/bin/pcsx5_core.dll" Link="pcsx5_core.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/../../build/bin/Release/pcsx5_core.dll') And !Exists('$(MSBuildProjectDirectory)/../../build/bin/pcsx5_core.dll')">
    <Content Include="$(MSBuildProjectDirectory)/../../build/bin/Release/pcsx5_core.dll" Link="pcsx5_core.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
