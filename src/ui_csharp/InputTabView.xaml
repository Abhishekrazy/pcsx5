<UserControl x:Class="Pcsx5Ui.InputTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Pcsx5Ui"
             Focusable="False">
    <!--
        Live controller view.  Reads the pad only through CoreBridge (the
        native reader); renders the DualSense from assets/gamepad/dualsense
        using the vendored VSCView layout.  No emulator state lives here.

        Every visible string is an I18n key; every interactive control carries
        an AutomationProperties.Name; brushes are DynamicResource so a theme
        can be swapped later (Rule 12).
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: picker, live controller, tests -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Picker row -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="{loc:Tr Key=input.controller}"
                           Foreground="{DynamicResource ForegroundMutedBrush}"
                           FontSize="{DynamicResource TypeM}" Margin="0,0,10,0"/>
                <ComboBox x:Name="PadPicker" DockPanel.Dock="Left" MinWidth="220"
                          AutomationProperties.Name="{loc:Tr Key=input.controller}"
                          SelectionChanged="PadPicker_SelectionChanged"/>
                <TextBlock x:Name="TransportText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="14,0,0,0" FontSize="{DynamicResource TypeM}"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
            </DockPanel>

            <!-- Controller canvas.  1150x850 is the theme's design space. -->
            <Border Grid.Row="1" Background="{DynamicResource GlassBackgroundBrush}"
                    CornerRadius="12" Padding="8">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="PadCanvas" Width="1150" Height="850"/>
                </Viewbox>
            </Border>

            <!-- Tests -->
            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                <Button x:Name="InputTestBtn" Margin="0,0,8,8" Padding="14,8"
                        AutomationProperties.Name="{loc:Tr Key=input.test_input}"
                        Content="{loc:Tr Key=input.test_input}" Click="InputTestBtn_Click"/>
                <Button x:Name="SpeakerTestBtn" Margin="0,0,8,8" Padding="14,8"
                        AutomationProperties.Name="{loc:Tr Key=input.test_speaker}"
                        Content="{loc:Tr Key=input.test_speaker}" Click="SpeakerTestBtn_Click"/>
                <Button x:Name="HapticsTestBtn" Margin="0,0,8,8" Padding="14,8"
                        AutomationProperties.Name="{loc:Tr Key=input.test_haptics}"
                        Content="{loc:Tr Key=input.test_haptics}" Click="HapticsTestBtn_Click"/>
                <TextBlock x:Name="TestStatusText" VerticalAlignment="Center" Margin="6,0,0,8"
                           TextWrapping="Wrap" MaxWidth="520"
                           FontSize="{DynamicResource TypeM}"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
            </WrapPanel>
        </Grid>

        <!-- RIGHT: device information + motion -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource GlassBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=input.device_info}" FontWeight="Bold"
                                   FontSize="{DynamicResource TypeL}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Key=input.battery}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,2,12,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BatteryText" Margin="0,2,0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Key=input.connection}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,2,12,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ConnectionText" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Key=input.headphones}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,2,12,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HeadphoneText" Margin="0,2,0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr Key=input.microphone}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,2,12,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MicText" Margin="0,2,0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr Key=input.usb}" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,2,12,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="UsbText" Margin="0,2,0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource GlassBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="FirmwareRefreshBtn" DockPanel.Dock="Right" Padding="10,4"
                                    AutomationProperties.Name="{loc:Tr Key=input.refresh}"
                                    Content="{loc:Tr Key=input.refresh}" Click="FirmwareRefreshBtn_Click"/>
                            <TextBlock Text="{loc:Tr Key=input.firmware}" FontWeight="Bold"
                                       FontSize="{DynamicResource TypeL}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="FirmwareText" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource GlassBackgroundBrush}" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=input.motion}" FontWeight="Bold"
                                   FontSize="{DynamicResource TypeL}" Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Tr Key=input.accelerometer}" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        <Canvas x:Name="AccelGraph" Height="90" Margin="0,4,0,10" ClipToBounds="True"/>
                        <TextBlock Text="{loc:Tr Key=input.gyroscope}" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        <Canvas x:Name="GyroGraph" Height="90" Margin="0,4,0,0" ClipToBounds="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
