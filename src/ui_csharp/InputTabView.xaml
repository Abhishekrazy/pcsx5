<UserControl x:Class="Pcsx5Ui.InputTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Pcsx5Ui"
             xmlns:local="clr-namespace:Pcsx5Ui"
             Focusable="False">
    <UserControl.Resources>
        <!-- Local outline-pill button (the shell's SecondaryButtonStyle lives in
             MainWindow's own resources, out of reach of this UserControl). -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="FontSize" Value="{DynamicResource TypeM}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" BorderBrush="{DynamicResource ThemeBorderStrong}"
                                BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerM}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource ThemeRaised}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!--
        Live controller view.  Reads the pad only through CoreBridge (the
        native reader); renders the DualSense from assets/gamepad/dualsense
        as a 3D model (assets/gamepad/dualsense3d).  No emulator state lives here.

        Rebuilt to the concept artboard 2026-09-06: hairline-border cards on
        flat theme tokens, a left diagram + tests column and a right device /
        motion / keyboard column. Every visible string is an I18n key; every
        interactive control carries an AutomationProperties.Name; brushes are
        DynamicResource (Rule 12).
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: picker, live controller, tests -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Picker row: label + pad selector + a transport pill -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="{loc:Tr Key=input.controller}"
                           Foreground="{DynamicResource ThemeTextMuted}"
                           FontSize="{DynamicResource TypeM}" Margin="0,0,10,0"/>
                <ComboBox x:Name="PadPicker" DockPanel.Dock="Left" MinWidth="220"
                          AutomationProperties.Name="{loc:Tr Key=input.controller}"
                          SelectionChanged="PadPicker_SelectionChanged"/>
                <Border DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center"
                        Background="Transparent" BorderBrush="{DynamicResource ThemeBorderStrong}"
                        BorderThickness="1" CornerRadius="{DynamicResource ThemeCornerM}" Padding="12,5">
                    <TextBlock x:Name="TransportText" FontFamily="Consolas, monospace"
                               FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}"/>
                </Border>
            </DockPanel>

            <!-- Controller canvas.  1150x850 is the theme's design space; capped
                 so it never pushes the tests and mapping editor off-screen. -->
            <!-- The pad sits directly on the emulator ground (no card), fills the
                 available height and centres itself. -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeGround}" BorderThickness="0"
                    Padding="12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid>
                    <!-- 3D DualSense (assets/gamepad/dualsense3d), animated from the live pad state. -->
                    <local:ControllerVisualizer3D x:Name="Pad3D"/>
                </Grid>
            </Border>

            <!-- Tests -->
            <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                <Button x:Name="InputTestBtn" Margin="0,0,10,8" MinHeight="44" Padding="18,0"
                        Style="{StaticResource OutlineButton}"
                        AutomationProperties.Name="{loc:Tr Key=input.test_input}"
                        Content="{loc:Tr Key=input.test_input}" Click="InputTestBtn_Click"/>
                <Button x:Name="SpeakerTestBtn" Margin="0,0,10,8" MinHeight="44" Padding="18,0"
                        Style="{StaticResource OutlineButton}"
                        AutomationProperties.Name="{loc:Tr Key=input.test_speaker}"
                        Content="{loc:Tr Key=input.test_speaker}" Click="SpeakerTestBtn_Click"/>
                <Button x:Name="HapticsTestBtn" Margin="0,0,10,8" MinHeight="44" Padding="18,0"
                        Style="{StaticResource OutlineButton}"
                        AutomationProperties.Name="{loc:Tr Key=input.test_haptics}"
                        Content="{loc:Tr Key=input.test_haptics}" Click="HapticsTestBtn_Click"/>
                <TextBlock x:Name="TestStatusText" VerticalAlignment="Center" Margin="6,0,0,8"
                           TextWrapping="Wrap" MaxWidth="520"
                           FontSize="{DynamicResource TypeM}"
                           Foreground="{DynamicResource ThemeTextMuted}"/>
            </WrapPanel>
        </Grid>

        <!-- RIGHT: device information + firmware + motion + keyboard/mouse -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Device -->
                <Border Background="Transparent" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1"
                        CornerRadius="{DynamicResource ThemeCornerL}" Padding="22" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=input.device_info}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,14"/>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="{loc:Tr Key=input.battery}" Foreground="{DynamicResource ThemeTextMuted}"/><TextBlock x:Name="BatteryText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontFamily="Consolas, monospace" Foreground="{DynamicResource ThemeText}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="{loc:Tr Key=input.connection}" Foreground="{DynamicResource ThemeTextMuted}"/><TextBlock x:Name="ConnectionText" DockPanel.Dock="Right" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" FontFamily="Consolas, monospace" Foreground="{DynamicResource ThemeText}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="{loc:Tr Key=input.headphones}" Foreground="{DynamicResource ThemeTextMuted}"/><TextBlock x:Name="HeadphoneText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontFamily="Consolas, monospace" Foreground="{DynamicResource ThemeText}"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="{loc:Tr Key=input.microphone}" Foreground="{DynamicResource ThemeTextMuted}"/><TextBlock x:Name="MicText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontFamily="Consolas, monospace" Foreground="{DynamicResource ThemeText}"/></DockPanel>
                        <DockPanel><TextBlock Text="{loc:Tr Key=input.usb}" Foreground="{DynamicResource ThemeTextMuted}"/><TextBlock x:Name="UsbText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontFamily="Consolas, monospace" Foreground="{DynamicResource ThemeText}"/></DockPanel>
                    </StackPanel>
                </Border>

                <!-- Firmware -->
                <Border Background="Transparent" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1"
                        CornerRadius="{DynamicResource ThemeCornerL}" Padding="22" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="FirmwareRefreshBtn" DockPanel.Dock="Right" Padding="12,4"
                                    Style="{StaticResource OutlineButton}"
                                    AutomationProperties.Name="{loc:Tr Key=input.refresh}"
                                    Content="{loc:Tr Key=input.refresh}" Click="FirmwareRefreshBtn_Click"/>
                            <TextBlock Text="{loc:Tr Key=input.firmware}" FontWeight="SemiBold"
                                       FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="FirmwareText" TextWrapping="Wrap" FontFamily="Consolas, monospace" Foreground="{DynamicResource ThemeText}"/>
                    </StackPanel>
                </Border>

                <!-- Motion -->
                <Border Background="Transparent" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1"
                        CornerRadius="{DynamicResource ThemeCornerL}" Padding="22" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=input.motion}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,12"/>
                        <TextBlock Text="{loc:Tr Key=input.accelerometer}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="{DynamicResource TypeS}"/>
                        <Canvas x:Name="AccelGraph" Height="90" Margin="0,4,0,12" ClipToBounds="True"/>
                        <TextBlock Text="{loc:Tr Key=input.gyroscope}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="{DynamicResource TypeS}"/>
                        <Canvas x:Name="GyroGraph" Height="90" Margin="0,4,0,0" ClipToBounds="True"/>
                    </StackPanel>
                </Border>

                <!-- Keyboard & mouse -->
                <Border Background="Transparent" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1"
                        CornerRadius="{DynamicResource ThemeCornerL}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=input.kbm}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource TypeS}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Tr Key=input.kbm_help}" TextWrapping="Wrap" LineHeight="21"
                                   FontSize="{DynamicResource TypeM}" Foreground="{DynamicResource ThemeTextMuted}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
